#!/bin/bash
# Regenerate /etc/pacman.d/mirrorlist: anycast CDN first, then rate-ranked AU/NZ mirrors.
set -euo pipefail
tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT
{
  echo '##'
  echo '## Generated by mirror-refresh on '"$(date -Is)"
  echo '## Do not edit by hand - rerun /usr/local/bin/mirror-refresh'
  echo '##'
  echo
  echo '## Anycast CDN - follows whatever exit node you are on (incl. VPN)'
  echo 'Server = https://fastly.mirror.pkgbuild.com/$repo/os/$arch'
  echo
} > "$tmp"
reflector --country Australia,'New Zealand' --protocol https \
          --age 12 --completion-percent 100 --latest 20 --sort rate >> "$tmp"
grep -qE '^Server = ' "$tmp"
install -m644 "$tmp" /etc/pacman.d/mirrorlist

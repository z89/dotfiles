{
  "permissions": {
    "allow": [
      "Bash(pnpm dlx:*)",
      "Bash(pnpm build:*)",
      "Read(//home/archie/.claude/skills/commit/**)",
      "Bash(export SSH_AUTH_SOCK=\"/run/user/1000/ssh-agent.socket\")",
      "Bash(ssh-add -l)"
    ],
    "additionalDirectories": [
      "/home/archie/Documents/Github-Projects/***REDACTED***"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'ZSTACK_DIR=$(dirname $(dirname $(readlink -f ~/.claude/skills/z:build))) && $ZSTACK_DIR/bin/zstack-quality-gate'"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "clangd-lsp@claude-plugins-official": true
  }
}

# User override of /usr/share/applications/discord.desktop (package discord 1:1.0.157-1). Identical to the package entry
# except that Exec goes through /home/archie/.local/bin/focus-or-launch, so picking
# this app in the DMS launcher (Super + D) jumps to its open window, or starts it and
# follows it. XDG precedence makes this copy win. Full path is required: dms.service's
# PATH lacks ~/.local/bin. Revert: delete this file.
[Desktop Entry]
Name=Discord
StartupWMClass=discord
Comment=All-in-one voice and text chat for gamers that's free, secure, and works on both your desktop and phone.
GenericName=Internet Messenger
Exec=/home/archie/.local/bin/focus-or-launch discord -- /usr/bin/discord --url -- %u
Icon=discord
Type=Application
Categories=Network;InstantMessaging;
MimeType=x-scheme-handler/discord;
Path=/usr/bin

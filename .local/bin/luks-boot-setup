#!/usr/bin/env bash
# luks-boot-setup — make the boot-time LUKS unlock fast, stable and DMS-styled.
#
#   sudo ~/.local/bin/luks-boot-setup            apply config + theme, rebuild initramfs
#   sudo ~/.local/bin/luks-boot-setup --retune   also re-tune the passphrase keyslot (asks for it)
#   sudo ~/.local/bin/luks-boot-setup --dry-run  show what would change, touch nothing
#
# What it fixes (see journalctl -b -o short-monotonic | grep systemd-cryptsetup):
#   1. crypttab.initramfs: fido2-device=auto,token-timeout=10 made systemd-cryptsetup wait
#      the full 10 s for a YubiKey that is not plugged in before the Plymouth passphrase
#      prompt could appear. systemd tries FIDO2 exactly once, strictly before the passphrase,
#      so the wait is cut to 2 s (long enough for a key plugged in at power-on to enumerate).
#      tries=5 stops the burnt FIDO2 attempt eating the three passphrase attempts.
#   2. Root device job timeout: dev-archvg-root.device has a 90 s JobRunningTimeoutSec. Typing
#      the passphrase slower than that dropped the initrd into emergency mode ("Timed out
#      waiting for device /dev/archvg/root"). rootflags=x-systemd.device-timeout=infinity on
#      the kernel command line removes that timer; GRUB's own rootflags=subvol=@ is kept
#      because systemd concatenates repeated rootflags= values.
#   3. Passphrase slot priority: cryptsetup tries keyslots in order, each costing a full
#      argon2id derivation (~1 GiB, ~1 s). Marking the passphrase slot "prefer" makes it the
#      first one tried. --retune additionally rebenchmarks that slot to ~1 s / 512 MiB.
#   4. Plymouth theme "dank-unlock", generated from the live DMS palette and wallpaper by
#      plymouth-dank-theme, replaces the stock spinner theme.
#   5. fido2-smart mkinitcpio hook (~/.local/share/initcpio/install/fido2-smart): wraps
#      systemd-cryptsetup so the FIDO2 token is only tried when it is actually plugged in
#      (USB enumeration is watched, not timed), and the passphrase prompt appears at once
#      otherwise. With the key present it makes one touch-only attempt (headless, capped at
#      15 s) and falls back to the plain passphrase prompt if that does not unlock.
#   6. initrd-rescue mkinitcpio hook: if plymouth dies mid-unlock the console passphrase
#      prompt is restored within half a second, and the initramfs emergency shell is made
#      openable (the image ships a locked root account) and quick. Crash-triggered only.
#   7. FIDO2 keyslot flags: systemd-cryptenroll enrols with a PIN requirement by default.
#      If the token metadata says PIN or user verification is required, the slot is
#      re-enrolled touch-only (needs the key plugged in; asks the passphrase and the key's
#      PIN once) and the old FIDO2 slot is wiped.
#
# Idempotent: every step checks before it writes. Header changes are preceded by a LUKS
# header backup in /root/luks-header-backup/. Nothing here touches the running session.
set -euo pipefail

# The LUKS container is discovered from the running system rather than hardcoded: a
# disk UUID is a hardware identifier and this repo is public. Walk the block-device
# ancestry of whatever is mounted at / until a crypto_LUKS parent turns up. Override
# with LUKS_UUID=... to target a disk other than the running root.
find_luks_uuid() {
    local src name fstype uuid
    # findmnt appends the subvolume for btrfs (/dev/mapper/x[/@]); lsblk wants the device.
    src=$(findmnt -no SOURCE / 2>/dev/null | sed 's/\[.*\]$//') || return 1
    [[ -n $src ]] || return 1
    while read -r name fstype uuid; do
        [[ $fstype == crypto_LUKS && -n $uuid ]] || continue
        printf '%s' "$uuid"
        return 0
    done < <(lsblk -lnso NAME,FSTYPE,UUID "$src" 2>/dev/null)
    return 1
}

LUKS_UUID=${LUKS_UUID:-$(find_luks_uuid || true)}
[[ -n $LUKS_UUID ]] || { echo "no LUKS container found under / (set LUKS_UUID= to override)"; exit 1; }
MAPPER=cryptlvm
THEME=dank-unlock
CRYPTTAB_OPTS="fido2-device=auto,token-timeout=2,tries=5,timeout=0"
ROOTFLAG="rootflags=x-systemd.device-timeout=infinity"

dry=0 retune=0
for a in "$@"; do
  case $a in
    --dry-run) dry=1 ;;
    --retune) retune=1 ;;
    *) echo "unknown option: $a"; exit 1 ;;
  esac
done
[[ $EUID -eq 0 || $dry -eq 1 ]] || { echo "run with sudo (or --dry-run)"; exit 1; }
user=${SUDO_USER:-archie}
home=$(getent passwd "$user" | cut -d: -f6)
dev=/dev/disk/by-uuid/$LUKS_UUID
[[ -e $dev ]] || { echo "LUKS device $dev not found"; exit 1; }

changed=0
run() { if (( dry )); then echo "  would: $*"; else "$@"; fi; }
note() { echo "-> $*"; }

# 1. crypttab.initramfs -----------------------------------------------------------------
want="$MAPPER    UUID=$LUKS_UUID    -    $CRYPTTAB_OPTS"
ct=/etc/crypttab.initramfs
# Only the $MAPPER line is managed here. Any other volume the user has added keeps its own
# line: rewriting the whole file would silently drop it and the next boot would never
# unlock it.
cur=$(awk -v m="$MAPPER" '$1 == m { print; exit }' "$ct" 2>/dev/null || true)
if [[ $cur != "$want" ]]; then
  note "crypttab.initramfs: $MAPPER -> $CRYPTTAB_OPTS"
  if (( ! dry )); then
    cp -a "$ct" "$ct.bak-$(date +%Y%m%d%H%M%S)" 2>/dev/null || true
    if [[ -n $cur ]]; then
      awk -v m="$MAPPER" -v w="$want" '$1 == m { print w; next } { print }' "$ct" > "$ct.new"
    else
      { [[ -f $ct ]] && cat "$ct"; printf '%s\n' "$want"; } > "$ct.new"
    fi
    # Sanity: the managed line must be present exactly once and no other line may vanish.
    if [[ $(awk -v m="$MAPPER" '$1 == m' "$ct.new" | wc -l) != 1 ]]; then
      echo "  STOP: refusing to write $ct (managed line not unique)"; rm -f "$ct.new"; exit 1
    fi
    mv "$ct.new" "$ct"; chmod 600 "$ct"
  fi
  changed=1
else
  note "crypttab.initramfs already correct"
fi

# 2. GRUB kernel command line ------------------------------------------------------------
grub=/etc/default/grub
if ! grep -qF "$ROOTFLAG" "$grub"; then
  note "GRUB_CMDLINE_LINUX += $ROOTFLAG (and drop the duplicate 'splash')"
  if (( ! dry )); then
    cp -a "$grub" "$grub.bak-$(date +%Y%m%d%H%M%S)"
    sed -i -E "s|^GRUB_CMDLINE_LINUX=\"(.*)\"|GRUB_CMDLINE_LINUX=\"\1 $ROOTFLAG\"|" "$grub"
    # GRUB_CMDLINE_LINUX_DEFAULT already carries 'quiet splash'; the copy in GRUB_CMDLINE_LINUX
    # only produced 'splash quiet splash' on the real command line.
    sed -i -E '/^GRUB_CMDLINE_LINUX=/{s/ splash( |")/\1/;s/"splash /"/}' "$grub"
    sed -i -E '/^GRUB_CMDLINE_LINUX=/s/  +/ /g' "$grub"
    grep -E '^GRUB_CMDLINE_LINUX' "$grub"
  fi
  grub_changed=1
else
  note "GRUB cmdline already has $ROOTFLAG"
  grub_changed=0
fi

# 2b. mkinitcpio HOOKS: Arch wiki asks for plymouth before sd-encrypt ------------------
mk=/etc/mkinitcpio.conf
if grep -qE '^HOOKS=.*\bsd-encrypt\b.* \bplymouth\b' "$mk"; then
  note "mkinitcpio.conf: move plymouth hook before sd-encrypt"
  if (( ! dry )); then
    cp -a "$mk" "$mk.bak-$(date +%Y%m%d%H%M%S)"
    sed -i -E '/^HOOKS=/{s/ plymouth\b//;s/ sd-encrypt\b/ plymouth sd-encrypt/}' "$mk"
    grep -E '^HOOKS=' "$mk"
  fi
  changed=1
else
  note "mkinitcpio HOOKS order already fine"
fi

# 2c. custom mkinitcpio hooks from dotfiles ------------------------------------------------
#   fido2-smart     after sd-encrypt : FIDO2 only when the token is plugged in, else passphrase at once
#   windows-escape  after plymouth   : hold Super on the unlock screen to reboot into Windows
install_hook() {
  local name=$1 after=$2 src="$home/.local/share/initcpio/install/$1" dst="/etc/initcpio/install/$1"
  if [[ ! -f $src ]]; then note "$src missing; hook $name not installed"; return; fi
  if ! cmp -s "$src" "$dst"; then
    note "install hook: $dst <- $src"
    run install -D -m 644 "$src" "$dst"
    changed=1
  else
    note "install hook $name already current"
  fi
  if ! grep -qE "^HOOKS=.*\\b$name\\b" "$mk"; then
    note "mkinitcpio.conf: add $name after $after"
    if (( ! dry )); then
      cp -a "$mk" "$mk.bak-$(date +%Y%m%d%H%M%S)"
      sed -i -E "/^HOOKS=/s/ $after\\b/ $after $name/" "$mk"
      grep -E '^HOOKS=' "$mk"
    fi
    changed=1
  else
    note "mkinitcpio HOOKS already has $name"
  fi
}
install_hook initrd-rescue sd-encrypt
install_hook fido2-smart sd-encrypt
install_hook windows-escape plymouth
HINT="Hold the Windows key to boot Windows"

# 3. Keyslot priority (and optional retune) ---------------------------------------------
backup_header() {
  local dir=/root/luks-header-backup f
  f="$dir/luks-$LUKS_UUID-$(date +%Y%m%d%H%M%S).img"
  mkdir -p "$dir"; chmod 700 "$dir"
  cryptsetup luksHeaderBackup "$dev" --header-backup-file "$f"
  chmod 600 "$f"
  echo "  header backed up to $f"
}
if (( EUID == 0 )); then
  meta=$(cryptsetup luksDump --dump-json-metadata "$dev")
  read -r pass_slot fido_slot <<<"$(python3 - "$meta" <<'PY'
import json, sys
m = json.loads(sys.argv[1])
token_slots = {s for t in m.get("tokens", {}).values() for s in t.get("keyslots", [])}
slots = sorted(m["keyslots"], key=int)
passw = [s for s in slots if s not in token_slots]
fido = [s for t in m.get("tokens", {}).values() if t.get("type") == "systemd-fido2" for s in t.get("keyslots", [])]
print(passw[0] if passw else "-", fido[0] if fido else "-")
PY
)"
  echo "  keyslots: passphrase=$pass_slot fido2=$fido_slot"
  fido_flags() {  # prints "touch" | "reenrol" | "none" and describes each systemd-fido2 token
    python3 - "$meta" <<'PY'
import json, sys
m = json.loads(sys.argv[1])
toks = [t for t in m.get("tokens", {}).values() if t.get("type") == "systemd-fido2"]
state = "none"
for t in toks:
    pin = t.get("fido2-clientPin-required"); up = t.get("fido2-up-required"); uv = t.get("fido2-uv-required")
    print(f"  fido2 token: PIN required={pin} touch required={up} user-verification={uv}", file=sys.stderr)
    ok = pin is False and up is True and not uv
    state = "touch" if ok and state != "reenrol" else "reenrol"
print(state)
PY
  }
  fido_plugged_in() {
    local h
    for h in /sys/class/hidraw/hidraw*; do
      [[ -e $h ]] || continue
      udevadm info -q property -p "$h" 2>/dev/null | grep -qx 'ID_FIDO_TOKEN=1' && return 0
    done
    return 1
  }
  fido_state=$(fido_flags)
  case $fido_state in
    touch)  note "fido2 keyslot is touch-only (no PIN, no user verification)" ;;
    none)   note "no fido2 keyslot enrolled; the key would need: systemd-cryptenroll $dev --fido2-device=auto --fido2-with-client-pin=no" ;;
    reenrol)
      # systemd-cryptenroll defaults to --fido2-with-client-pin=yes, which makes every keyed
      # boot stop for the PIN. Enrol a fresh touch-only credential and wipe the old FIDO2
      # slot(s); --wipe-slot runs after a successful enrolment and keeps the new slot
      # (systemd-cryptenroll(1)). The key's own PIN is still asked once here, because the
      # authenticator requires it to *create* a credential, never again at boot.
      # --wipe-slot=fido2 would remove EVERY fido2 slot, including a second, backup security
      # key. Wipe the exact slots seen in the dump instead, and name them before doing it.
      old_fido_slots=$(python3 -c "import json,sys; m=json.loads(sys.argv[1]); print(','.join(sorted({s for t in m.get('tokens',{}).values() if t.get('type')=='systemd-fido2' for s in t.get('keyslots',[])}, key=int)))" "$meta")
      if fido_plugged_in; then
        note "re-enrolling the fido2 keyslot touch-only: enter the LUKS passphrase, the key's PIN once, then touch the key"
        echo "  this will replace fido2 keyslot(s): ${old_fido_slots:-none}"
        echo "  if a second security key is enrolled on this disk, it will stop working; Control + C now to abort"
        if (( ! dry )); then
          backup_header
          systemd-cryptenroll "$dev" --fido2-device=auto --fido2-with-client-pin=no \
            --fido2-with-user-presence=yes --fido2-with-user-verification=no \
            ${old_fido_slots:+--wipe-slot="$old_fido_slots"}
          meta=$(cryptsetup luksDump --dump-json-metadata "$dev")
          # Lockout guard: a passphrase slot must still exist before we go anywhere near a reboot.
          if ! python3 -c "import json,sys; m=json.loads(sys.argv[1]); t={s for k in m.get('tokens',{}).values() for s in k.get('keyslots',[])}; sys.exit(0 if [s for s in m['keyslots'] if s not in t] else 1)" "$meta"; then
            echo "  STOP: no passphrase keyslot left on $dev after re-enrolment. Do not reboot."
            echo "  Restore the header from the backup printed above with:"
            echo "    cryptsetup luksHeaderRestore $dev --header-backup-file <file>"
            exit 1
          fi
          if [[ $(fido_flags) != touch ]]; then
            echo "  WARNING: the new enrolment still needs PIN/UV. The key most likely enforces"
            echo "  'always user verification'; turn that off (ykman fido config toggle-always-uv)"
            echo "  and rerun this script."
          fi
        fi
      else
        note "fido2 keyslot needs a PIN or UV at boot; plug the YubiKey in and rerun to re-enrol it touch-only"
      fi ;;
  esac
  if [[ $pass_slot != - ]]; then
    prio=$(python3 -c "import json,sys;print(json.loads(sys.argv[1])['keyslots']['$pass_slot'].get('priority','normal'))" "$meta")
    if [[ $prio != prefer ]]; then
      note "keyslot $pass_slot: priority normal -> prefer (tried first on passphrase entry)"
      if (( ! dry )); then
        backup_header
        cryptsetup config --key-slot "$pass_slot" --priority prefer "$dev"
      fi
    else
      note "keyslot $pass_slot already 'prefer'"
    fi
    if (( retune && ! dry )); then
      note "re-tuning argon2id on keyslot $pass_slot to ~1 s / 512 MiB (enter the passphrase when asked)"
      backup_header
      cryptsetup luksConvertKey --key-slot "$pass_slot" --pbkdf argon2id --iter-time 1000 \
        --pbkdf-memory 524288 --pbkdf-parallel 4 "$dev"
    fi
  else
    echo "  no passphrase-only keyslot found; skipping priority/retune"
  fi
else
  note "keyslot priority/retune: needs root, skipped"
fi

# 4. Plymouth theme ----------------------------------------------------------------------
gen="$home/.local/bin/plymouth-dank-theme"
build="$home/.cache/plymouth-dank-theme"
if [[ -x $gen ]]; then
  note "generating $THEME from the current DMS palette + wallpaper"
  run sudo -H -u "$user" "$gen" --out "$build" --hint "$HINT"
  if (( ! dry )); then
    rm -rf "/usr/share/plymouth/themes/$THEME"
    cp -r "$build" "/usr/share/plymouth/themes/$THEME"
    chown -R root:root "/usr/share/plymouth/themes/$THEME"
    chmod -R u=rwX,go=rX "/usr/share/plymouth/themes/$THEME"
  fi
  if [[ "$(plymouth-set-default-theme 2>/dev/null)" != "$THEME" ]]; then
    note "plymouthd.conf: Theme=$THEME"
    run plymouth-set-default-theme "$THEME"
  fi
  changed=1
else
  note "$gen missing; leaving the plymouth theme alone"
fi

# 5. Regenerate -------------------------------------------------------------------------
if (( grub_changed )); then
  note "grub-mkconfig -o /boot/grub/grub.cfg"
  run grub-mkconfig -o /boot/grub/grub.cfg
fi
if (( changed )); then
  # Neither preset builds a -fallback image, so a broken initramfs would leave no second GRUB
  # entry to boot. Keep the last known-good images next to them: at the GRUB menu press "e",
  # append .bak to the initrd line and press Control + X to boot the previous image.
  # Neither preset builds a -fallback image and grub.cfg has no second entry, so the .bak
  # copies are the only way back. Rotate one ONLY when the image on disk was not produced by
  # this script: otherwise a second run would overwrite the last known-good backup with the
  # output of the previous run. The stamp also makes the backup follow kernel updates, so a
  # .bak is never left holding modules for a kernel that no longer exists.
  stamp=/boot/.luks-boot-setup.sha256
  note "refreshing the *.img.bak safety copies"
  for img in /boot/initramfs-linux.img /boot/initramfs-linux-lts.img; do
    [[ -f $img ]] || continue
    ours=$(awk -v i="$img" '$2 == i { print $1 }' "$stamp" 2>/dev/null || true)
    now=$(sha256sum "$img" | cut -d" " -f1)
    if [[ -n $ours && $ours == "$now" ]]; then
      echo "  keeping $img.bak (current image was built by this script)"
    else
      run cp -a "$img" "$img.bak"
      echo "  $img.bak <- current image"
    fi
  done

  note "mkinitcpio -P"
  if (( dry )); then
    echo "  would: mkinitcpio -P"
  else
    log=$(mktemp)
    # mkinitcpio prints fatal lines as '==> ERROR:' and, when only a build hook fails, still
    # writes an image and reports the failure solely through its exit status. Both are checked.
    if ! mkinitcpio -P >"$log" 2>&1; then
      echo
      echo "  STOP: mkinitcpio failed. The images on /boot may be incomplete. DO NOT REBOOT."
      grep -iE '^==> ERROR|error|warning' "$log" | head -20 | sed "s/^/    /"
      echo
      echo "  Restore the previous images and try again:"
      for img in /boot/initramfs-linux.img /boot/initramfs-linux-lts.img; do
        [[ -f $img.bak ]] && echo "    cp -a $img.bak $img"
      done
      echo "  Full log: $log"
      exit 1
    fi
    grep -iE 'warning|Image generation' "$log" | tail -6 | sed "s/^/  /"
    rm -f "$log"

    # The exit status can still be 0 while a hook silently produced nothing useful, so check
    # that what the hooks are supposed to install is actually inside each image.
    miss=0
    for img in /boot/initramfs-linux.img /boot/initramfs-linux-lts.img; do
      [[ -f $img ]] || continue
      for want in usr/local/bin/cryptsetup-fido2-smart usr/local/bin/boot-windows \
                  usr/local/bin/windows-escape-evdev usr/local/bin/initrd-rescue-watch \
                  usr/bin/unlock \
                  etc/systemd/system/emergency.service.d/initrd-rescue.conf; do
        lsinitcpio "$img" 2>/dev/null | grep -qx "$want" || { echo "  MISSING in $img: $want"; miss=1; }
      done
    done
    if (( miss )); then
      echo
      echo "  STOP: the new images are missing files the hooks should have installed."
      echo "  Restore with the cp commands above and do not reboot until this is resolved."
      exit 1
    fi
    note "verified: both images carry the fido2-smart wrapper, the Windows escape and the rescue watchdog"
    : > "$stamp"; chmod 600 "$stamp"
    for img in /boot/initramfs-linux.img /boot/initramfs-linux-lts.img; do
      [[ -f $img ]] && printf '%s %s\n' "$(sha256sum "$img" | cut -d" " -f1)" "$img" >> "$stamp"
    done
  fi
fi

echo
echo "Done. Next boot: no key plugged in -> passphrase prompt as soon as USB has enumerated (~2.5 s uptime);"
echo "      key plugged in before power-on -> touch the key (no PIN, no passphrase); untouched for 15 s -> passphrase prompt;
      key plugged in while the prompt is up -> touch it or keep typing, whichever you reach for first wins."
echo "Log line to look for: fido2-smart: ... (journalctl -b | grep fido2-smart)"
echo "If the new initramfs ever fails to boot: at the GRUB menu press e, add .bak to the"
echo "      initrd line (initramfs-linux.img.bak) and press Control + X."
echo "Check the timeline after a boot with:"
echo "  journalctl -b -o short-monotonic | grep -E 'systemd-cryptsetup\\[|Cryptography Setup'"

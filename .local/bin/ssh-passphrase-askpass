#!/usr/bin/env bash
# ssh-passphrase-askpass: the window that asks for a key passphrase. ssh-unlock forces it
# for ssh-add, and ssh falls back to it when it has no terminal. terminals keep their usual
# prompt for anything else because SSH_ASKPASS_REQUIRE is not set globally. a yes/no
# confirmation from ssh-agent itself goes through ssh-confirm-askpass.
if [ -z "${WAYLAND_DISPLAY:-}" ]; then
    for s in "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"/wayland-[0-9]*; do
        case "$s" in *.lock) continue ;; esac
        [ -S "$s" ] && { export WAYLAND_DISPLAY="${s##*/}"; break; }
    done
fi
exec zenity --password --title="SSH key" --text="${1:-Enter the key passphrase}" 2>/dev/null

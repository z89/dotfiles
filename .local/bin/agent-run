#!/usr/bin/env bash
# ---------------------------------------------------------------------------
# Run any coding agent with a GitHub App identity instead of yours.
#
#   agent-run claude
#   agent-run codex
#   agent-run gh pr list          # works for one-off commands too
#
# WHAT IT SWAPS
#   GH_TOKEN            a fresh App token, one hour, scoped to the installed repository
#   GIT_CONFIG_GLOBAL   an owner-specific agent git config: ssh remotes rewritten
#                       to https, credentials taken from GH_TOKEN, commits
#                       attributed to the matching App bot and locally signed
#   SSH_AUTH_SOCK       REMOVED, so nothing can sign or push with your key
#   AGENT_SSH_KEY       the shared passphrase-less agent key (~/.config/agent-ssh); the
#                       `mac-agent` ssh alias uses it. Never registered on GitHub.
#   GITHUB_TOKEN        removed, so a stale one cannot win over GH_TOKEN
#
# THREE THINGS EACH CLOSE A DIFFERENT HOLE, and all three are needed:
#
#   - GH_TOKEN alone covers the `gh` CLI and nothing else. `git push` would still
#     authenticate over ssh, as you, and the commit would carry your signature.
#   - The git config alone would have no token to authenticate with.
#   - Leaving SSH_AUTH_SOCK in place would leave a working path back to your
#     identity for any tool that prefers ssh.
#
# WHAT THIS IS NOT
# It is not a sandbox. It sets the DEFAULT correctly for every agent launched
# through it, on this operating system, whatever the agent is written in - but it
# runs as your Unix user, and a process running as you can read
# ~/.config/gh/hosts.yml and reach /run/user/1000 no matter what its environment
# says. Making that impossible needs a separate Unix user or a namespace; this
# makes the correct thing automatic, not compulsory.
#
# The agent cannot reach any repository the App is not installed on - every other
# one returns 404. That is deliberate where one repository holds the controls
# for another: the thing being controlled should not be able to edit them.
#
# ---------------------------------------------------------------------------
set -euo pipefail

if [ $# -eq 0 ]; then
  echo "usage: agent-run <command> [args...]     e.g. agent-run claude" >&2
  exit 64
fi

MINT="${AGENT_GH_MINT:-$HOME/.local/bin/mint-agent-token}"

# Select the App from the repository owner. This prevents an agent launched in a
# personal repository from silently receiving the organisation identity (or vice
# versa). An explicit profile is useful only when launching outside a repository.
#
# The owner -> profile mapping is NOT written here. Every profile directory carries
# an untracked config that already declares the account it serves (OWNER= for a user,
# ORG= for an organisation), so this script discovers the mapping at runtime and the
# public dotfiles repo never learns which accounts exist. Profile directories are
# ~/.config/agent-gh (the original) and ~/.config/agent-gh-<name>.
PROFILE="${AGENT_GH_PROFILE:-}"
if [ -z "${PROFILE}" ]; then
  if ! git rev-parse --git-dir >/dev/null 2>&1; then
    echo "agent-run: not in a Git repository; set AGENT_GH_PROFILE=<account> or AGENT_GH_CONF" >&2
    exit 1
  fi
  URL="$(git config --get remote.origin.url || true)"
  REPO_OWNER="$(printf '%s' "${URL}" |
    sed -nE 's#^(git@github\.com:|ssh://git@github\.com/|https://github\.com/)([^/]+)/.*#\2#p')"
  [ -n "${REPO_OWNER}" ] || {
    echo "agent-run: cannot determine a GitHub owner from origin: ${URL:-<unset>}" >&2
    exit 1
  }
  PROFILE="${REPO_OWNER}"
fi

# Resolve the profile directory. A directory named after the profile wins outright;
# otherwise every profile config is read and the one declaring this account is used.
# GitHub account names are case-insensitive, so the comparison is too.
lower() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]'; }
declared_account() { # profile dir -> the account its config serves, or nothing
  sed -nE 's/^[[:space:]]*(OWNER|ORG)=["'"'"']?([^"'"'"'[:space:]#]+).*/\2/p' "$1/config" 2>/dev/null | head -1
}

PROFILE_DIR=""
if [ -r "$HOME/.config/agent-gh-${PROFILE}/config" ]; then
  PROFILE_DIR="$HOME/.config/agent-gh-${PROFILE}"
else
  for d in "$HOME"/.config/agent-gh "$HOME"/.config/agent-gh-*; do
    [ -r "$d/config" ] || continue
    a="$(declared_account "$d")"
    [ -n "$a" ] || continue
    if [ "$(lower "$a")" = "$(lower "${PROFILE}")" ]; then
      PROFILE_DIR="$d"
      break
    fi
  done
fi

if [ -z "${PROFILE_DIR}" ]; then
  echo "agent-run: no App profile for '${PROFILE}'." >&2
  echo "agent-run: add ~/.config/agent-gh-${PROFILE}/ (config, agent.pem, gitconfig)," >&2
  echo "agent-run: or set OWNER=/ORG= in an existing profile config to claim that account." >&2
  exit 1
fi

CONF="${AGENT_GH_CONF:-$PROFILE_DIR/config}"
KEY="${AGENT_GH_KEY:-$PROFILE_DIR/agent.pem}"
AGENT_GITCONFIG="${AGENT_GH_GITCONFIG:-$PROFILE_DIR/gitconfig}"

[ -x "${MINT}" ]           || { echo "agent-run: ${MINT} not found or not executable" >&2; exit 1; }
[ -r "${CONF}" ]            || { echo "agent-run: ${CONF} not readable" >&2; exit 1; }
[ -r "${KEY}" ]             || { echo "agent-run: ${KEY} not readable" >&2; exit 1; }
[ -r "${AGENT_GITCONFIG}" ] || { echo "agent-run: ${AGENT_GITCONFIG} not readable" >&2; exit 1; }

# Do not let unrelated caller variables impersonate values from the selected
# profile. The supported overrides are the explicit AGENT_GH_* variables above.
unset ORG OWNER BOT_LOGIN BOT_EMAIL
# shellcheck disable=SC1090
. "${CONF}"
BOT_LOGIN="${BOT_LOGIN:-}"
BOT_EMAIL="${BOT_EMAIL:-}"
PROFILE_OWNER="${OWNER:-${ORG:-}}"
[ -n "${BOT_LOGIN}" ] && [ -n "${BOT_EMAIL}" ] && [ -n "${PROFILE_OWNER}" ] || {
  echo "agent-run: ${CONF} must define BOT_LOGIN and BOT_EMAIL plus OWNER or ORG" >&2
  exit 1
}
[ -z "${REPO_OWNER:-}" ] || [ "${REPO_OWNER}" = "${PROFILE_OWNER}" ] || {
  echo "agent-run: repository owner '${REPO_OWNER}' does not match profile owner '${PROFILE_OWNER}'" >&2
  exit 1
}

# Fail here rather than launching an agent that silently falls back to your
# credentials. A missing token must stop the run, not degrade it.
if ! TOKEN="$(AGENT_GH_CONF="${CONF}" AGENT_GH_KEY="${KEY}" "${MINT}")" || [ -z "${TOKEN}" ]; then
  echo "agent-run: could not mint an App token; refusing to start with your credentials" >&2
  exit 1
fi

# `env -u` rather than `unset`, so the child cannot inherit them however it is
# spawned. GIT_CONFIG_GLOBAL replaces ~/.gitconfig for git; GIT_CONFIG_SYSTEM is
# emptied too, since a system-wide url rewrite or credential helper would
# otherwise still apply.
exec env -u SSH_AUTH_SOCK -u GITHUB_TOKEN -u GIT_SSH_COMMAND \
  GH_TOKEN="${TOKEN}" \
  GIT_CONFIG_GLOBAL="${AGENT_GITCONFIG}" \
  GIT_CONFIG_SYSTEM=/dev/null \
  AGENT_GH=1 \
  AGENT_SSH_KEY="${HOME}/.config/agent-ssh/agent_ed25519" \
  AGENT_GH_PROFILE="${PROFILE}" \
  AGENT_GH_OWNER="${PROFILE_OWNER}" \
  AGENT_GH_BOT_LOGIN="${BOT_LOGIN}" \
  AGENT_GH_BOT_EMAIL="${BOT_EMAIL}" \
  "$@"

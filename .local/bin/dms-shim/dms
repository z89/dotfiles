#!/usr/bin/env bash
# dms shim seen only by DMS (dms-run-patched prepends this dir to PATH).
# The shell runs `dms matugen queue ... --value <wallpaper>`; this swaps the wallpaper
# for a cached 640px thumbnail so the palette does not depend on dms-shell-patch
# applying. On the full-size image matugen picks a different source colour (lofi-girl:
# #ffaed8 instead of #ffb1c2) and the worker takes ~600ms longer. Same cache and key as
# scripts/dms-matugen-thumb, whose thumbnails pass through untouched.
# Everything else passes through.
[[ ${1:-} == matugen && ${2:-} == queue ]] || exec /usr/bin/dms "$@"
cache=${XDG_CACHE_HOME:-$HOME/.cache}/dms-matugen-thumbs
args=("$@")
for ((i = 0; i < ${#args[@]} - 1; i++)); do
    [[ ${args[i]} == --value ]] || continue
    src=${args[i+1]}
    if [[ $src == /* && $src != "$cache"/* && -f $src ]]; then
        key=$(printf '%s:%s' "$src" "$(stat -c %Y:%s -- "$src" 2>/dev/null)" | md5sum | cut -c1-16)
        thumb=$cache/$key.jpg
        if [[ ! -s $thumb ]] && mkdir -p "$cache"; then
            magick "$src[0]" -auto-orient -resize '640x640>' -quality 92 "$thumb.tmp.jpg" 2>/dev/null \
                && mv -f "$thumb.tmp.jpg" "$thumb" || rm -f "$thumb.tmp.jpg"
        fi
        [[ -s $thumb ]] && args[i+1]=$thumb
    fi
    break
done
exec /usr/bin/dms "${args[@]}"

    cat > "$tmp/scripts/dms-matugen-thumb" <<'SH'
#!/usr/bin/env bash
# dms-matugen-thumb (dms-shell-patch): run the matugen worker against a cached 640px
# thumbnail of the wallpaper. matugen quantises a downscaled copy anyway, so the palette is
# the same, but decoding a 5120x1440 JPEG twice (dank16 extraction + matugen) cost ~600ms.
#   dms-matugen-thumb matugen queue ... --value <image> ...   exec dms with the thumbnail
#   dms-matugen-thumb --warm <image>...                        pre-generate thumbnails
cache=${XDG_CACHE_HOME:-$HOME/.cache}/dms-matugen-thumbs
thumb_for() {   # prints the thumbnail for $1, generating it if needed; prints nothing on failure
    local src=$1 key thumb
    key=$(printf '%s:%s' "$src" "$(stat -c %Y:%s -- "$src" 2>/dev/null)" | md5sum | cut -c1-16)
    thumb=$cache/$key.jpg
    if [[ ! -s $thumb ]]; then
        mkdir -p "$cache" || return
        if ! magick "$src[0]" -auto-orient -resize '640x640>' -quality 92 "$thumb.tmp.jpg" 2>/dev/null \
            || ! mv -f "$thumb.tmp.jpg" "$thumb"; then
            rm -f "$thumb.tmp.jpg"; return
        fi
    fi
    printf '%s' "$thumb"
}
if [[ ${1:-} == --warm ]]; then
    shift; for f in "$@"; do [[ -f $f ]] && thumb_for "$f" >/dev/null; done; exit 0
fi
args=("$@")
for ((i = 0; i < ${#args[@]} - 1; i++)); do
    if [[ ${args[i]} == --value && ${args[i+1]} == /* && -f ${args[i+1]} ]]; then
        t=$(thumb_for "${args[i+1]}"); [[ -n $t ]] && args[i+1]=$t
        break
    fi
done
exec dms "${args[@]}"
SH
    chmod +x "$tmp/scripts/dms-matugen-thumb"
}

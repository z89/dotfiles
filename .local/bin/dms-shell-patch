            enabled: paletteSnap.fading
            NumberAnimation { duration: Theme.colorFadeMs; easing.type: Easing.OutCubic }
        }
    }
    property bool paletteSnapArmed: false
    Connections {
        target: Theme
        function onPaletteSnapshotRequested() {
            if (!barWindow.visible || body.width <= 0 || body.height <= 0)
                return;
            paletteSnap.fading = false;
            paletteSnap.opacity = 0;
            paletteSnap.scheduleUpdate();
            Theme.snapshotsPending++;
            barWindow.paletteSnapArmed = true;
        }
        function onMatugenColorsChanged() {
            if (paletteSnap.opacity <= 0)
                return;
            paletteSnap.fading = true;
            paletteSnap.opacity = 0;
        }
    }
    Connections {
        target: barWindow.paletteSnapArmed ? paletteStampProbe.qwin : null
        property bool synced: false
        function onAfterSynchronizing() { synced = true; }
        function onFrameSwapped() {
            if (!synced)
                return;
            synced = false;
            barWindow.paletteSnapArmed = false;
            if (Theme.paletteHeld) {          // the cap may have flipped the palette already
                paletteSnap.fading = false;
                paletteSnap.opacity = 1;      // never rendered: the flip follows in this call
            }
            Theme.snapshotsPending--;
        }
    }
""")

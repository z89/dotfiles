    // dms-shell-patch: stamp the first frame presented with a new palette. The render
    // thread syncs, renders, then swaps; a frame already in flight at the flip swaps
    // before any post-flip sync and is skipped. See Theme.paletteStamped.
    Item {
        id: paletteStampProbe
        readonly property var qwin: Window.window
        visible: false
    }
    Connections {
        target: Theme.paletteStampPending ? paletteStampProbe.qwin : null
        property bool synced: false
        function onAfterSynchronizing() { synced = true; }
        function onFrameSwapped() { if (synced) { synced = false; Theme.paletteStamped(); } }
    }
    // dms-shell-patch: palette crossfade. Theme asks for a snapshot before a new palette lands;
    // the bar renders itself once into paletteSnap (one bar-sized texture) and reports back.
    // After the flip the snapshot fades out over the live, recoloured bar: one opacity animation.
    ShaderEffectSource {
        id: paletteSnap
        anchors.fill: body
        z: 1000
        sourceItem: body
        live: false
        hideSource: false
        mipmap: false
        opacity: 0

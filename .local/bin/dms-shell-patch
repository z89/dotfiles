#!/usr/bin/env bash
# Build a patched copy of the DMS embedded shell UI.
# Source: the shell dms extracts to $XDG_RUNTIME_DIR/danklinux-shell/<hash> on a stock start.
# Output: ~/.local/share/dms-shell-patched (used via DMS_SHELL_DIR by dms-run-patched).
# Patches: launcher size, launcher centred between the bar edge and the opposite screen edge, Spotlight bar width,
# lock-screen crossfade, compact notification popup card, synced palette/wallpaper fades,
# volume percent at the head of the control centre pill.
# Re-run after every dms upgrade; dms-run-patched does this automatically.
set -euo pipefail

SPOT_WIDTH=${SPOT_WIDTH:-1600}        # Spotlight bar width (stock: 680)
SPOT_RESULTS_H=${SPOT_RESULTS_H:-560} # Spotlight max results height (stock: 430)
FULL_WIDTH=${FULL_WIDTH:-1800}        # Full launcher "compact" size width (stock: 620) - this is what Super+D opens
FULL_HEIGHT=${FULL_HEIGHT:-900}       # Full launcher "compact" size height (stock: 600)

RUNTIME=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
OUT=${DMS_SHELL_PATCHED:-$HOME/.local/share/dms-shell-patched}
BIN=$(command -v dms)
BIN_SHA=$(sha256sum "$BIN" | cut -d' ' -f1)

# Stock source, in order: DMS_SHELL_SRC override; the tree dms extracts on a stock start
# (tmpfs, gone after a reboot); a cached copy of the upstream source at the installed
# commit (~/.cache/dms-shell-stock/<short-rev>, quickshell/ plus the dank-qml-common
# submodule as DankCommon/), which survives reboots and yay cache purges.
src=${DMS_SHELL_SRC:-}
[[ -n "$src" ]] || src=$(ls -td "$RUNTIME"/danklinux-shell/*/ 2>/dev/null | head -1 || true)
if [[ -z "$src" || ! -f "$src/shell.qml" ]]; then
    rev=$(pacman -Q dms-shell-git 2>/dev/null | grep -oE 'g[0-9a-f]{7,}' | head -1 | cut -c2-)
    [[ -n "$rev" && -f "$HOME/.cache/dms-shell-stock/$rev/shell.qml" ]] && src="$HOME/.cache/dms-shell-stock/$rev"
fi
if [[ -z "$src" || ! -f "$src/shell.qml" ]]; then
    echo "dms-shell-patch: no stock shell source (start dms stock once, or populate ~/.cache/dms-shell-stock/<rev>)" >&2
    exit 1
fi
src=${src%/}

tmp=$(mktemp -d "${OUT}.tmp.XXXX")
trap 'rm -rf "$tmp"' EXIT
cp -a "$src"/. "$tmp"/
chmod -R u+w "$tmp"

patch_one() { # file, sed-expr, must-match-regex
    local f=$1 expr=$2 must=$3
    grep -qE "$must" "$f" || { echo "dms-shell-patch: pattern not found in ${f#$tmp/}: $must" >&2; exit 2; }
    sed -i -E "$expr" "$f"
    if grep -qE "$must" "$f"; then echo "dms-shell-patch: patch did not apply in ${f#$tmp/}" >&2; exit 2; fi
}

SPOT=$tmp/Modals/DankLauncherV2
patch_one "$SPOT/DankLauncherV2ModalSpotlight.qml" \
    "s/modalWidth: Math\.min\(680, screenWidth - 80\)/modalWidth: Math.min($SPOT_WIDTH, screenWidth - 80)/" \
    'modalWidth: Math\.min\(680, screenWidth - 80\)'
patch_one "$SPOT/SpotlightLauncherContent.qml" \
    "s/Math\.min\(430, \(parentModal\?\.screenHeight \?\? 900\) \* 0\.55\)/Math.min($SPOT_RESULTS_H, (parentModal?.screenHeight ?? 900) * 0.7)/" \
    'Math\.min\(430, \(parentModal\?\.screenHeight \?\? 900\) \* 0\.55\)'
patch_one "$SPOT/DankLauncherV2ModalStandalone.qml" \
    "s/return 620;/return $FULL_WIDTH;/" 'return 620;'
patch_one "$SPOT/DankLauncherV2ModalStandalone.qml" \
    "s/return 600;/return $FULL_HEIGHT;/" 'return 600;'

patch_one "$SPOT/DankLauncherV2ModalStandalone.qml" \
    "s|readonly property real modalY: \(screenHeight - modalHeight\) / 2|readonly property real modalY: { const bw = BarWidgetService.getBarWindowForScreen(effectiveScreen?.name ?? \"\"); const ez = Math.max(0, bw?.exclusiveZone ?? 0); const pos = bw?.barConfig?.position ?? SettingsData.Position.Top; const top = pos === SettingsData.Position.Top ? ez : 0; const bottom = pos === SettingsData.Position.Bottom ? ez : 0; return top + Math.max(0, (screenHeight - top - bottom - modalHeight) / 2); }|" \
    'readonly property real modalY: \(screenHeight - modalHeight\) / 2'

# ---- Lock screen crossfade (optional) -------------------------------------------
# Super+Alt+L (dms ipc call lock lock) crossfades a copy of the lock screen over the
# desktop before the real session lock engages, and fades it back out on unlock.
# Hyprland cannot animate session-lock surfaces, so this lives in the shell. The block
# is skipped with a warning (launcher patches still apply) if upstream changed the files.
LOCK_FADE=${LOCK_FADE:-1}             # 0 disables the block
LOCK_FADE_IN=${LOCK_FADE_IN:-900}     # ms, desktop -> lock screen
LOCK_FADE_OUT=${LOCK_FADE_OUT:-800}   # ms, lock screen -> desktop
STOCK_FADE_WINDOW_SHA=34e02e2660ca6634610b35f6f28304a51c2cc7db170efc2761dfce688826701e

lock_fade_files=(Modules/Lock/Lock.qml DMSShell.qml Services/IdleService.qml Modules/Lock/FadeToLockWindow.qml Modules/Lock/LockScreenContent.qml)
lock_fade_skip() {
    echo "dms-shell-patch: lock fade skipped: $1" >&2
    local f
    for f in "${lock_fade_files[@]}"; do cp -a "$src/$f" "$tmp/$f"; done
    LOCK_FADE=0
}
apply_lock_fade() {
    local have
    have=$(sha256sum "$tmp/Modules/Lock/FadeToLockWindow.qml" | cut -d' ' -f1)
    [[ "$have" == "$STOCK_FADE_WINDOW_SHA" ]] || { lock_fade_skip "FadeToLockWindow.qml changed upstream"; return; }
    [[ $(grep -c '^            root\.lock();$' "$tmp/Modules/Lock/Lock.qml") == 1 ]] || { lock_fade_skip "Lock.qml IPC anchor"; return; }
    grep -q '^    signal dismissFadeToLock$' "$tmp/Services/IdleService.qml" || { lock_fade_skip "IdleService.qml anchor"; return; }
    [[ $(grep -c '^                function onCancelFadeToLock() {$' "$tmp/DMSShell.qml") == 1 ]] || { lock_fade_skip "DMSShell.qml anchor"; return; }
    [[ $(grep -c 'return "••••••••";' "$tmp/Modules/Lock/LockScreenContent.qml") == 1 ]] || { lock_fade_skip "LockScreenContent.qml anchor"; return; }

    LOCK_FADE_IN="$LOCK_FADE_IN" python3 - "$tmp" <<'PY'
import os, sys
tmp = sys.argv[1]
ms = int(os.environ["LOCK_FADE_IN"])
def edit(rel, old, new):
    p = os.path.join(tmp, rel); s = open(p).read()
    assert s.count(old) == 1, rel
    open(p, "w").write(s.replace(old, new))
edit("Services/IdleService.qml", "    signal dismissFadeToLock\n",
     "    signal dismissFadeToLock\n    signal quickFadeToLockRequested\n")
edit("Modules/Lock/Lock.qml", "            root.lock();\n",
     "            // Crossfade into the lock screen instead of cutting to it (dms-shell-patch).\n"
     "            if (SettingsData.fadeToLockEnabled && !root.shouldLock && !root.pendingLock && !(SettingsData.customPowerActionLock?.length > 0))\n"
     "                IdleService.quickFadeToLockRequested();\n"
     "            else\n"
     "                root.lock();\n")
# The overlay copy runs LockScreenContent in demoMode, which shows placeholder
# password dots for the settings preview. demoPassword=false keeps the field
# looking exactly like the real, empty lock prompt.
edit("Modules/Lock/LockScreenContent.qml", "    property bool demoMode: false\n",
     "    property bool demoMode: false\n    property bool demoPassword: true\n")
edit("Modules/Lock/LockScreenContent.qml",
     "                            if (demoMode) {\n                                return \"\";\n                            }\n                            if (root.unlocking) {\n",
     "                            if (demoMode) {\n                                return root.demoPassword ? \"\" : \"Password...\";\n                            }\n                            if (root.unlocking) {\n")
edit("Modules/Lock/LockScreenContent.qml", "                                return \"••••••••\";\n",
     "                                return root.demoPassword ? \"••••••••\" : \"\";\n")
edit("Modules/Lock/LockScreenContent.qml", "opacity: (demoMode || root.passwordBuffer.length > 0) ? 1 : 0\n",
     "opacity: ((demoMode && root.demoPassword) || root.passwordBuffer.length > 0) ? 1 : 0\n")
edit("DMSShell.qml", "                function onCancelFadeToLock() {\n",
     "                function onQuickFadeToLockRequested() {\n"
     "                    if (fadeWindowLoader.loadedWindow) {\n"
     f"                        fadeWindowLoader.loadedWindow.startFade({ms});\n"
     "                    }\n"
     "                }\n\n"
     "                function onCancelFadeToLock() {\n")
PY
    sed "s/@LOCK_FADE_OUT@/$LOCK_FADE_OUT/" > "$tmp/Modules/Lock/FadeToLockWindow.qml" <<'QML'
pragma ComponentBehavior: Bound

import QtQuick
import Quickshell
import Quickshell.Wayland
import qs.Common
import qs.Services

PanelWindow {
    id: root

    property bool active: false
    property bool _completed: false
    // quick: a manual lock. The lock screen's own look crossfades in over the
    // desktop; once it is fully opaque the real session lock takes over and the
    // switch is invisible. Not cancellable.
    property bool quick: false
    property int quickMs: 0
    property bool revealing: false

    signal fadeCompleted
    signal fadeCancelled

    visible: active
    color: "transparent"

    WlrLayershell.namespace: "dms:fade-to-lock"
    WlrLayershell.layer: WlrLayershell.Overlay
    WlrLayershell.exclusiveZone: -1
    WlrLayershell.keyboardFocus: active && !revealing ? WlrKeyboardFocus.Exclusive : WlrKeyboardFocus.None

    anchors {
        left: true
        right: true
        top: true
        bottom: true
    }

    // Idle path: the stock dim-to-black over the grace period.
    Rectangle {
        id: fadeOverlay

        anchors.fill: parent
        color: "black"
        opacity: 0
        visible: !root.quick

        onOpacityChanged: {
            if (opacity >= 0.99 && root.active && !root._completed) {
                root._completed = true;
                root.fadeCompleted();
            }
        }
    }

    // Manual path: a visual copy of the lock screen that fades in over the desktop.
    Item {
        id: lockLook

        anchors.fill: parent
        opacity: 0
        visible: root.quick && opacity > 0

        onOpacityChanged: {
            if (opacity >= 0.995 && root.active && root.quick && !root._completed) {
                root._completed = true;
                root.fadeCompleted();
            }
        }

        Loader {
            anchors.fill: parent
            active: root.quick && root.active
            sourceComponent: LockScreenContent {
                demoMode: true
                demoPassword: false
                screenName: root.screen?.name ?? ""
            }
        }
    }

    SequentialAnimation {
        id: fadeSeq

        running: false

        NumberAnimation {
            target: root.quick ? lockLook : fadeOverlay
            property: "opacity"
            from: 0.0
            to: 1.0
            duration: root.quick ? root.quickMs : SettingsData.fadeToLockGracePeriod * 1000
            easing.type: root.quick ? Easing.InOutSine : Easing.OutCubic
        }
    }

    // Unlock after a manual lock: the lock look fades back out to the desktop.
    NumberAnimation {
        id: revealAnim

        target: lockLook
        property: "opacity"
        to: 0.0
        duration: @LOCK_FADE_OUT@
        easing.type: Easing.InOutSine
        onFinished: root.dismiss(true)
    }

    function reveal() {
        fadeSeq.stop();
        if (!quick) {
            dismiss(true);
            return;
        }
        revealing = true;
        revealAnim.restart();
    }

    function startFade(quickMs) {
        if (!SettingsData.fadeToLockEnabled)
            return;
        revealAnim.stop();
        revealing = false;
        quick = quickMs !== undefined && quickMs > 0;
        root.quickMs = quick ? quickMs : 0;
        _completed = false;
        active = true;
        fadeOverlay.opacity = 0.0;
        lockLook.opacity = 0.0;
        fadeSeq.stop();
        fadeSeq.start();
    }

    function cancelFade() {
        if (_completed || quick || revealing)
            return;
        fadeSeq.stop();
        fadeOverlay.opacity = 0.0;
        active = false;
        fadeCancelled();
    }

    // After a manual lock the overlay stays resident beneath the session lock
    // (DMS asks to dismiss it as soon as the lock is secure) so the lock look
    // is already on screen when the lock releases and can fade out to the desktop.
    function dismiss(force) {
        if (!force && quick && _completed && IdleService.isShellLocked)
            return;
        fadeSeq.stop();
        revealAnim.stop();
        fadeOverlay.opacity = 0.0;
        lockLook.opacity = 0.0;
        active = false;
        _completed = false;
        quick = false;
        revealing = false;
    }

    Connections {
        target: IdleService

        function onIsShellLockedChanged() {
            if (!IdleService.isShellLocked && root._completed)
                root.reveal();
        }
    }

    MouseArea {
        anchors.fill: parent
        enabled: root.active && !root.revealing
        onClicked: root.cancelFade()
        onPressed: root.cancelFade()
    }

    FocusScope {
        anchors.fill: parent
        focus: root.active

        Keys.onPressed: event => {
            root.cancelFade();
            event.accepted = true;
        }
    }

    Component.onCompleted: {
        if (active) {
            forceActiveFocus();
        }
    }

    onActiveChanged: {
        if (active) {
            forceActiveFocus();
        }
    }
}
QML
}
[[ "$LOCK_FADE" == 1 ]] && apply_lock_fade

# ---- Notification popup: compact banner card (optional) ---------------------------
# Rewrites the popup card body (Modules/Notifications/Popup/NotificationPopup.qml) into a
# compact banner: 36px rounded-square app icon, bold title with "app · time" on the right,
# body under it, close button on hover, action pills only when the app sends actions, a
# 2px timeout hairline. The card fragment lives in $NOTIF_CARD; the popup manager's
# minimum slot height is lowered to match. Skipped with a warning (other patches still
# apply) if upstream changed the anchors.
NOTIF_CARD_PATCH=${NOTIF_CARD_PATCH:-1}   # 0 disables the block
NOTIF_CARD=${NOTIF_CARD:-$HOME/.config/DankMaterialShell/patches/notification-popup-card.qml}
STOCK_NOTIF_POPUP_SHA=2518b088afefd63155b21b76dc7a6c00d72843efdd7f2524ec3a77543b21f57b

notif_card_files=(Modules/Notifications/Popup/NotificationPopup.qml Modules/Notifications/Popup/NotificationPopupManager.qml)
notif_card_skip() {
    echo "dms-shell-patch: notification card skipped: $1" >&2
    local f
    for f in "${notif_card_files[@]}"; do cp -a "$src/$f" "$tmp/$f"; done
    rm -f "$tmp/DankCommon/Widgets/DankRoundedImage.qml" "$tmp/Widgets/DankRoundedImage.qml"
    NOTIF_CARD_PATCH=0
}
apply_notif_card() {
    [[ -f "$NOTIF_CARD" ]] || { notif_card_skip "fragment $NOTIF_CARD missing"; return; }
    local have
    have=$(sha256sum "$tmp/Modules/Notifications/Popup/NotificationPopup.qml" | cut -d' ' -f1)
    [[ "$have" == "$STOCK_NOTIF_POPUP_SHA" ]] || { notif_card_skip "NotificationPopup.qml changed upstream"; return; }

    # DankRoundedImage: DankCircularImage with a configurable corner radius and no inset ring.
    local ci=$tmp/DankCommon/Widgets/DankCircularImage.qml
    local pat
    for pat in '^    id: root$' '^    radius: width / 2$' '^        radius: Math\.min\(width, height\) / 2$' '^        anchors\.margins: 2$'; do
        [[ $(grep -cE "$pat" "$ci") == 1 ]] || { notif_card_skip "DankCircularImage.qml anchor $pat"; return; }
    done
    sed -E \
        -e 's|^    id: root$|    id: root\n    property real cornerRadius: 8|' \
        -e 's|^    radius: width / 2$|    radius: cornerRadius|' \
        -e 's|^        radius: Math\.min\(width, height\) / 2$|        radius: root.cornerRadius|' \
        -e 's|^        anchors\.margins: 2$|        anchors.margins: 0|' \
        "$ci" > "$tmp/DankCommon/Widgets/DankRoundedImage.qml"
    sed 's/DankCircularImage/DankRoundedImage/' "$tmp/Widgets/DankCircularImage.qml" > "$tmp/Widgets/DankRoundedImage.qml"

    if ! NOTIF_CARD="$NOTIF_CARD" python3 - "$tmp" <<'PY2'
import os, sys
tmp = sys.argv[1]
frag = open(os.environ["NOTIF_CARD"]).read()

def between(s, start, end):
    i = s.index(start); j = s.index(end, i)
    return i, j

pp = os.path.join(tmp, "Modules/Notifications/Popup/NotificationPopup.qml")
s = open(pp).read()

# 1. geometry properties
i, j = between(s, "    readonly property bool compactMode: SettingsData.notificationCompactMode\n",
               "    readonly property real basePopupHeightPrivacy:")
j = s.index("\n", j) + 1
props = """    // dms-shell-patch: compact banner card geometry. Card body fragment:
    // ~/.config/DankMaterialShell/patches/notification-popup-card.qml
    readonly property bool compactMode: SettingsData.notificationCompactMode
    readonly property real cardPadding: compactMode ? 10 : 12
    // Bottom padding is larger than top: Inter's cap height sits well below the line box
    // while descenders barely reach its bottom, so equal numbers look bottom-heavy.
    readonly property real cardPaddingBottom: compactMode ? 14 : 17
    readonly property bool isCritical: notificationData?.urgency === NotificationUrgency.Critical
    readonly property real cardPaddingH: (compactMode ? 12 : 14) + (isCritical ? 6 : 0)
    readonly property real popupIconSize: compactMode ? 32 : 36
    readonly property real iconTextGap: 12
    readonly property real contentSpacing: 2
    readonly property real actionRowGap: compactMode ? 8 : 10
    readonly property real actionButtonHeight: compactMode ? 24 : 26
    readonly property real titleFontSize: SettingsData.notificationSummaryFontSize || Theme.fontSizeMedium
    readonly property real bodyFontSize: SettingsData.notificationBodyFontSize || (Theme.fontSizeSmall + 1)
    readonly property real metaFontSize: Theme.fontSizeSmall
    readonly property real bodyLineRatio: 1.2
    readonly property int collapsedBodyLines: compactMode ? 1 : 2
    readonly property bool hasActions: (notificationData?.actions?.length ?? 0) > 0
    readonly property string titleText: {
        const s = (notificationData?.summary ?? "").trim();
        return s.length > 0 ? s : (notificationData?.appName ?? "");
    }
    readonly property string metaText: {
        const app = (notificationData?.appName ?? "").trim();
        const t = notificationData?.timeStr ?? "";
        const parts = [];
        if (app.length > 0 && app.toLowerCase() !== titleText.toLowerCase())
            parts.push(app);
        if (t.length > 0)
            parts.push(t);
        return parts.join("  \\u00b7  ");
    }
    readonly property real titleLineHeight: Math.ceil(titleMeasure.implicitHeight || titleFontSize * 1.25)
    readonly property real bodyLineHeight: Math.ceil(bodyLineMeasure.contentHeight || bodyFontSize * bodyLineRatio)
    readonly property real collapsedBodyHeight: hasExpandableBody ? Math.ceil(Math.max(collapsedBodyMeasure.contentHeight, bodyLineHeight)) : 0
    readonly property real expandedBodyHeight: hasExpandableBody ? Math.ceil(Math.max(expandedBodyMeasure.contentHeight, collapsedBodyHeight)) : 0
    readonly property real textBlockHeight: titleLineHeight + (hasExpandableBody ? contentSpacing + collapsedBodyHeight : 0)
    readonly property real privacyTextBlockHeight: titleLineHeight + (hasExpandableBody ? contentSpacing + bodyLineHeight : 0)
    readonly property real collapsedContentHeight: Math.max(popupIconSize, textBlockHeight)
    readonly property real privacyCollapsedContentHeight: Math.max(popupIconSize, privacyTextBlockHeight)
    readonly property real actionsBlockHeight: hasActions ? actionRowGap + actionButtonHeight : 0
    readonly property real basePopupHeight: cardPadding + cardPaddingBottom + collapsedContentHeight + actionsBlockHeight
    readonly property real basePopupHeightPrivacy: cardPadding + cardPaddingBottom + privacyCollapsedContentHeight + actionsBlockHeight
"""
s = s[:i] + props + s[j:]

# 2. implicit size
i, j = between(s, "    readonly property real contentImplicitWidth:", "    readonly property real targetAlignedHeight:")
size = """    readonly property real contentImplicitWidth: screen ? Math.min(380, Math.max(320, screen.width * 0.22)) : 380
    readonly property real contentImplicitHeight: {
        if (SettingsData.notificationPopupPrivacyMode && !descriptionExpanded)
            return basePopupHeightPrivacy;
        if (!descriptionExpanded)
            return basePopupHeight;
        return basePopupHeight + Math.max(0, expandedBodyHeight - collapsedBodyHeight);
    }
"""
s = s[:i] + size + s[j:]

# 3. card body
i, j = between(s, "        // Keep critical accent outside shadow rendering so connected mode still shows it.\n",
               "            MouseArea {\n                id: cardHoverArea\n")
s = s[:i] + frag + s[j:]

# 4. no accent ring around critical cards: the leading-edge rail carries urgency
ring_c = "            borderColor: win.notificationData && win.notificationData.urgency === NotificationUrgency.Critical ? Theme.withAlpha(Theme.primary, 0.3) : Theme.withAlpha(Theme.outline, 0.08)\n"
ring_w = "            borderWidth: win.notificationData && win.notificationData.urgency === NotificationUrgency.Critical ? 2 : 0\n"
assert s.count(ring_c) == 1 and s.count(ring_w) == 1, "elevation ring anchor"
s = s.replace(ring_c, "            borderColor: Theme.withAlpha(Theme.outline, 0.08)\n").replace(ring_w, "            borderWidth: 0\n")

mp = os.path.join(tmp, "Modules/Notifications/Popup/NotificationPopupManager.qml")
m = open(mp).read()
old = "    readonly property int baseNotificationHeight: cardPadding * 2 + collapsedContentHeight + actionButtonHeight + contentSpacing + popupSpacing\n"
assert m.count(old) == 1, "manager anchor"
m = m.replace(old, "    readonly property int baseNotificationHeight: 12 + 17 + 36 + popupSpacing // dms-shell-patch: compact card minimum\n")

open(pp, "w").write(s)
open(mp, "w").write(m)
PY2
    then
        notif_card_skip "fragment splice failed"
        return
    fi
}
[[ "$NOTIF_CARD_PATCH" == 1 ]] && apply_notif_card

# ---- Theme sync: one clock for the bar, the wallpaper, kitty and GTK (optional) ----
# Common/Theme.qml holds a new dynamic palette until (a) every WallpaperBackground has decoded its
# new image, (b) theme-apply has prepared kitty/GTK and called `dms ipc call theme consumerReady`,
# and (c) each visible DankBarWindow has grabbed a snapshot of its current pixels (600ms cap).
# On the flip the bar fades that snapshot out over the recoloured live bar (one opacity animation;
# animating the palette properties themselves re-evaluated every colour binding in the shell on
# every frame and starved the render threads), WallpaperBackground starts its crossfade on the
# same tick, and DankBarWindow stamps the first frame it presents so theme-apply anchors kitty and
# the GTK flip there. All over THEME_FADE_MS, OutCubic. matugen runs against a cached 640px
# thumbnail (scripts/dms-matugen-thumb): identical palette, ~500ms less latency on a 5120x1440 image.
THEME_SYNC=${THEME_SYNC:-1}                 # 0 disables the block
THEME_FADE_MS=${THEME_FADE_MS:-500}         # keep equal to FADE_MS in ~/.local/bin/theme-apply

theme_sync_files=(Common/Theme.qml Modules/WallpaperBackground.qml Modules/DankBar/DankBarWindow.qml)
theme_sync_skip() {
    echo "dms-shell-patch: theme sync skipped: $1" >&2
    local f
    for f in "${theme_sync_files[@]}"; do cp -a "$src/$f" "$tmp/$f"; done
    THEME_SYNC=0
}
apply_theme_sync() {
    if ! THEME_FADE_MS="$THEME_FADE_MS" python3 - "$tmp" <<'PY2'
import os, re, sys
tmp = sys.argv[1]
ms = int(os.environ["THEME_FADE_MS"])

tp = os.path.join(tmp, "Common/Theme.qml")
t = open(tp).read()
old = "    property var workerRunning: false\n"
assert t.count(old) == 1, "Theme.qml workerRunning anchor"
t = t.replace(old, old + f"""    // dms-shell-patch: a palette change is a pixel crossfade of the bar (DankBarWindow
    // snapshots itself before the flip and fades the snapshot out over colorFadeMs) on the
    // same clock as the wallpaper crossfade and theme-apply's kitty/GTK fade. Armed after
    // startup so the first palette load does not animate; never in greeter mode.
    readonly property int colorFadeMs: {ms}
    property bool colorFadeArmed: false
    // True from the moment a regeneration is requested (100ms debounce included) until
    // the matugen worker exits; WallpaperBackground holds its crossfade on this.
    readonly property bool paletteRegenerating: workerRunning || !!_pendingGenerateParams
    Timer {{
        interval: 1500
        running: !SessionData.isGreeterMode
        repeat: false
        onTriggered: root.colorFadeArmed = true
    }}
    // Set on a palette flip; DankBarWindow clears it from the first frame it presents
    // with the new colours, touching the stamp theme-apply waits for (kitty fade, GTK flip).
    property bool paletteStampPending: false
    function paletteStamped() {{
        if (!paletteStampPending) return;
        paletteStampPending = false;
        paletteStampFile.setText(String(Date.now()));   // async in-process write: no fork, no UI stall
    }}
    FileView {{
        id: paletteStampFile
        path: root.stateDir + "/palette-applied.stamp"
        blockWrites: false
        atomicWrites: true
        printErrors: false
    }}
    // WallpaperBackground instances still decoding a new image. A big JPEG can outlast
    // matugen, so while any is decoding the new palette waits (capped) and the bar, the
    // terminals and the crossfade all start on the same frame.
    // theme-apply (kitty, GTK) calls `dms ipc call theme consumerReady` once it has prepared
    // the new palette; the palette is held for it too, so its fade starts on the same frame.
    property int wallpapersDecoding: 0
    property bool consumerReady: false
    property bool paletteHeld: false
    property bool _releasingPalette: false
    // Visible bars grab their pixels before the flip (paletteSnapshotRequested, once per
    // palette) and count themselves in snapshotsPending until the grab has rendered.
    property int snapshotsPending: 0
    property bool _snapshotAsked: false
    signal paletteSnapshotRequested()
    onSnapshotsPendingChanged: maybeReleasePalette()
    onWallpapersDecodingChanged: maybeReleasePalette()
    onWorkerRunningChanged: if (workerRunning) {{ consumerReady = false; _snapshotAsked = false; }}   // per palette
    function maybeReleasePalette() {{
        if (paletteHeld && consumerReady && snapshotsPending <= 0 && wallpapersDecoding <= 0)
            releaseHeldPalette();
    }}
    function releaseHeldPalette() {{
        paletteHoldCap.stop();
        paletteHeld = false;
        consumerReady = false;
        _snapshotAsked = false;
        _releasingPalette = true;
        dynamicColorsFileView.parseAndLoadColors();
        _releasingPalette = false;
    }}
    Timer {{
        id: paletteHoldCap
        interval: 600   // no consumer or a slow decode: apply anyway
        repeat: false
        onTriggered: root.releaseHeldPalette()
    }}
    Timer {{
        id: gtkPatchDefer
        interval: root.colorFadeMs + 700   // gtk.sh is a fork of this process: keep it off the fade
        repeat: false
        onTriggered: root.patchGtk3colors()
    }}
""")

old = "                const colorsText = dynamicColorsFileView.text();\n                if (colorsText) {\n"
assert t.count(old) == 1, "Theme.qml parseAndLoadColors text anchor"
t = t.replace(old, old + """                    if (!root._releasingPalette && currentTheme === dynamic && !SessionData.isGreeterMode) {
                        // dms-shell-patch: wait for the wallpaper decode, theme-apply and the bar snapshots
                        if (root.colorFadeArmed && !root._snapshotAsked) {

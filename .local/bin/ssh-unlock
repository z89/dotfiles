#!/usr/bin/env bash
# ssh-unlock: puts a key in the agent for four hours, asking for the passphrase in a window.
# ssh-sign runs it for the signing key (id_ed25519) before git signs a commit. ~/.ssh/config
# runs it with the GitHub key through `Match host github.com exec "ssh-unlock <key>"`, scoped
# to that host so background ssh to other hosts never opens a window. the question only comes
# when the key is about to be used. a key already in the agent returns straight away. the
# lock keeps two callers from opening two windows, and the one that waited finds the key
# loaded once the first window closes.
# ssh-lock-wipe empties the agent sooner when the session locks or suspends.
key="${1:-$HOME/.ssh/id_ed25519}"
life=4h
run="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export SSH_AUTH_SOCK="${SSH_AUTH_SOCK:-$run/ssh-agent.socket}"
blob=$(cut -d' ' -f2 "$key.pub" 2>/dev/null) && [ -n "$blob" ] || exit 1
loaded() { ssh-add -L 2>/dev/null | grep -qF "$blob"; }
loaded && exit 0
exec 9>"$run/ssh-unlock.lock"
flock 9
loaded && exit 0
SSH_ASKPASS="$HOME/.local/bin/ssh-passphrase-askpass" SSH_ASKPASS_REQUIRE=force \
    exec ssh-add -t "$life" "$key" </dev/null >/dev/null 2>&1

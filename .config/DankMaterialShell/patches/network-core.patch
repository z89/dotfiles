+func connectionPriorityUpdates(settings map[string]map[string]dbus.Variant, connType string, priority int32, metric int64) []string {
+	var updates []string
+	if !priorityMatches(settings["connection"]["autoconnect-priority"], int64(priority)) {
+		updates = append(updates, "connection.autoconnect-priority", fmt.Sprint(priority))
+	}
+	for _, family := range []string{"ipv4", "ipv6"} {
+		section := settings[family]
+		current, explicit := variantInt64(section["route-metric"])
+		// A network-type preference must not erase administrator-set Wi-Fi metrics.
+		if connType == "802-11-wireless" && explicit && current >= 0 {
+			continue
+		}
+		if !routeMetricMatches(section, metric) {
+			updates = append(updates, family+".route-metric", fmt.Sprint(metric))
+		}
+	}
+	return updates
+}

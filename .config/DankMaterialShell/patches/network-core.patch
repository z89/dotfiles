diff --git a/core/internal/server/network/multiwifi_test.go b/core/internal/server/network/multiwifi_test.go
new file mode 100644
index 000000000..55530a1c0
--- /dev/null
+++ b/core/internal/server/network/multiwifi_test.go
@@ -0,0 +1,126 @@
+package network
+
+import (
+	"fmt"
+	mocknm "github.com/AvengeMedia/DankMaterialShell/core/internal/mocks/github.com/Wifx/gonetworkmanager/v2"
+	"github.com/Wifx/gonetworkmanager/v2"
+	"github.com/godbus/dbus/v5"
+	"github.com/stretchr/testify/require"
+	"testing"
+)
+
+func TestMultiWiFiKeepsCurrentAdapter(t *testing.T) {
+	nm := mocknm.NewMockNetworkManager(t)
+	b, err := NewNetworkManagerBackend(nm)
+	require.NoError(t, err)
+	nm.EXPECT().GetPropertyActiveConnections().Return([]gonetworkmanager.ActiveConnection{}, nil).Maybe()
+	usb := mocknm.NewMockDevice(t)
+	internal := mocknm.NewMockDevice(t)
+	usb.EXPECT().GetPropertyState().Return(gonetworkmanager.NmDeviceStateActivated, nil).Maybe()
+	usb.EXPECT().GetPath().Return("/usb").Maybe()
+	internal.EXPECT().GetPropertyState().Return(gonetworkmanager.NmDeviceStateActivated, nil).Maybe()
+	internal.EXPECT().GetPath().Return("/internal").Maybe()
+	b.setWifiDeviceInfo("wlp0s20f0u5", &wifiDeviceInfo{device: usb, name: "wlp0s20f0u5"})
+	b.setWifiDeviceInfo("wlp7s0", &wifiDeviceInfo{device: internal, name: "wlp7s0"})
+	b.wifiDevice = usb
+	b.state.WiFiDevice = "wlp7s0"
+	selected, _ := b.wifiDeviceForState()
+	require.Same(t, internal, selected)
+}
+
+func TestMultiWiFiCompletesOnRequestedAdapter(t *testing.T) {
+	for _, targetState := range []gonetworkmanager.NmDeviceState{gonetworkmanager.NmDeviceStatePrepare, gonetworkmanager.NmDeviceStateActivated} {
+		t.Run(fmt.Sprint(targetState), func(t *testing.T) {
+			nm := mocknm.NewMockNetworkManager(t)
+			b, err := NewNetworkManagerBackend(nm)
+			require.NoError(t, err)
+			nm.EXPECT().GetPropertyActiveConnections().Return([]gonetworkmanager.ActiveConnection{}, nil).Maybe()
+			usb := mocknm.NewMockDevice(t)
+			internal := mocknm.NewMockDevice(t)
+			wireless := mocknm.NewMockDeviceWireless(t)
+			ap := mocknm.NewMockAccessPoint(t)
+			usb.EXPECT().GetPropertyState().Return(gonetworkmanager.NmDeviceStateActivated, nil).Maybe()
+			usb.EXPECT().GetPath().Return("/usb").Maybe()
+			usb.EXPECT().GetPropertyInterface().Return("wlp0s20f0u5", nil).Maybe()
+			usb.EXPECT().GetPropertyIP4Config().Return(nil, nil).Maybe()
+			internal.EXPECT().GetPropertyState().Return(targetState, nil).Maybe()
+			internal.EXPECT().GetPropertyInterface().Return("wlp7s0", nil).Maybe()
+			internal.EXPECT().GetPath().Return("/internal").Maybe()
+			internal.EXPECT().GetPropertyIP4Config().Return(nil, nil).Maybe()
+			wireless.EXPECT().GetPropertyActiveAccessPoint().Return(ap, nil).Maybe()
+			ap.EXPECT().GetPath().Return("/ap").Maybe()
+			ap.EXPECT().GetPropertySSID().Return("five-ghz", nil).Maybe()
+			ap.EXPECT().GetPropertyStrength().Return(uint8(80), nil).Maybe()
+			ap.EXPECT().GetPropertyHWAddress().Return("aa:bb:cc:dd:ee:ff", nil).Maybe()
+			b.setWifiDeviceInfo("wlp0s20f0u5", &wifiDeviceInfo{device: usb, name: "wlp0s20f0u5"})
+			b.setWifiDeviceInfo("wlp7s0", &wifiDeviceInfo{device: internal, wireless: wireless, name: "wlp7s0"})
+			b.wifiDevice = usb
+			b.state.IsConnecting = true
+			b.state.ConnectingSSID = "five-ghz"
+			b.state.ConnectingDevice = "wlp7s0"
+			selected, _ := b.wifiDeviceForState()
+			require.Same(t, internal, selected)
+			require.NoError(t, b.updateWiFiState())
+			require.Equal(t, targetState != gonetworkmanager.NmDeviceStateActivated, b.state.IsConnecting)
+			require.Equal(t, "wlp7s0", b.state.WiFiDevice)
+			if targetState == gonetworkmanager.NmDeviceStateActivated {
+				require.Empty(t, b.state.ConnectingDevice)
+				require.Empty(t, b.state.ConnectingSSID)
+			}
+		})
+	}
+}
+
+func TestMultiWiFiPreservesExplicitMetrics(t *testing.T) {
+	for _, metric := range []int64{0, 100, 300, 600} {
+		settings := map[string]map[string]dbus.Variant{
+			"connection": {"autoconnect-priority": dbus.MakeVariant(int32(100))},
+			"ipv4":       {"route-metric": dbus.MakeVariant(metric)},
+			"ipv6":       {"route-metric": dbus.MakeVariant(metric + 1)},
+		}
+		require.Empty(t, connectionPriorityUpdates(settings, "802-11-wireless", 100, 300))
+		updates := connectionPriorityUpdates(settings, "802-3-ethernet", 100, 300)
+		require.Contains(t, updates, "ipv6.route-metric")
+	}
+	settings := map[string]map[string]dbus.Variant{"ipv4": {"route-metric": dbus.MakeVariant(int64(-1))}}
+	require.Contains(t, connectionPriorityUpdates(settings, "802-11-wireless", 100, 300), "ipv4.route-metric")
+}
+
+func TestMultiWiFiUnplugClearsPendingConnection(t *testing.T) {
+	nm := mocknm.NewMockNetworkManager(t)
+	b, err := NewNetworkManagerBackend(nm)
+	require.NoError(t, err)
+	settings := mocknm.NewMockSettings(t)
+	settings.EXPECT().ListConnections().Return([]gonetworkmanager.Connection{}, nil).Maybe()
+	b.settings = settings
+	target := mocknm.NewMockDevice(t)
+	target.EXPECT().GetPath().Return("/target")
+	b.wifiDevice = target
+	b.setWifiDeviceInfo("wlp7s0", &wifiDeviceInfo{device: target, name: "wlp7s0"})
+	b.state.IsConnecting = true
+	b.state.ConnectingSSID = "five-ghz"
+	b.state.ConnectingDevice = "wlp7s0"
+	b.handleDeviceRemoved("/target")
+	require.False(t, b.state.IsConnecting)
+	require.Empty(t, b.state.ConnectingDevice)
+	require.NotEmpty(t, b.state.LastError)
+}
+
+func TestMultiWiFiFailedTargetRemainsSelectedForFailureHandling(t *testing.T) {
+	nm := mocknm.NewMockNetworkManager(t)
+	b, err := NewNetworkManagerBackend(nm)
+	require.NoError(t, err)
+	nm.EXPECT().GetPropertyActiveConnections().Return([]gonetworkmanager.ActiveConnection{}, nil).Maybe()
+	usb := mocknm.NewMockDevice(t)
+	target := mocknm.NewMockDevice(t)
+	usb.EXPECT().GetPropertyState().Return(gonetworkmanager.NmDeviceStateActivated, nil).Maybe()
+	usb.EXPECT().GetPath().Return("/usb").Maybe()
+	target.EXPECT().GetPropertyState().Return(gonetworkmanager.NmDeviceStateFailed, nil).Maybe()
+	b.wifiDevice = usb
+	b.setWifiDeviceInfo("wlp0s20f0u5", &wifiDeviceInfo{device: usb, name: "wlp0s20f0u5"})
+	b.setWifiDeviceInfo("wlp7s0", &wifiDeviceInfo{device: target, name: "wlp7s0"})
+	b.state.IsConnecting = true
+	b.state.ConnectingDevice = "wlp7s0"
+	selected, _ := b.wifiDeviceForState()
+	require.Same(t, target, selected)
+}

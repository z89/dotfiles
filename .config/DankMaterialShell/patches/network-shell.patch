diff --git a/Services/WifiDeviceState.js b/Services/WifiDeviceState.js
new file mode 100644
index 000000000..e8455753d
--- /dev/null
+++ b/Services/WifiDeviceState.js
@@ -0,0 +1,23 @@
+function selected(state, deviceName) {
+    const device = (state.wifiDevices || []).find(d => d.name === deviceName);
+    if (!device)
+        return state;
+    const sameDevice = device.name === state.wifiDevice;
+    return {
+        wifiDevice: device.name,
+        wifiConnected: device.connected === true,
+        wifiSSID: device.ssid || "",
+        wifiBSSID: device.bssid || "",
+        wifiIP: device.ip || "",
+        wifiSignal: device.signal || 0,
+        wifiNetworks: device.networks || [],
+        wifiConnectionUuid: sameDevice ? state.wifiConnectionUuid || "" : "",
+        wifiDevicePath: sameDevice ? state.wifiDevicePath || "" : "",
+        activeAccessPointPath: sameDevice ? state.activeAccessPointPath || "" : ""
+    };
+}
+
+function completed(state, ssid, deviceName) {
+    return state.wifiConnected === true && state.wifiSSID === ssid && !!state.wifiIP
+        && (!deviceName || state.wifiDevice === deviceName);
+}
diff --git a/tests/multiwifi.test.mjs b/tests/multiwifi.test.mjs
new file mode 100644
index 000000000..1d98cb5d0
--- /dev/null
+++ b/tests/multiwifi.test.mjs
@@ -0,0 +1,30 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { loadScript } from "./qml-script.mjs";
+const wifi = loadScript(new URL("../Services/WifiDeviceState.js", import.meta.url));
+const state = {
+    wifiDevice: "usb", wifiSSID: "two-ghz", wifiConnected: true, wifiIP: "192.0.2.1",
+    wifiDevicePath: "/usb", wifiNetworks: [{ssid: "two-ghz"}],
+    wifiDevices: [
+        {name: "usb", connected: true, ssid: "two-ghz", ip: "192.0.2.1"},
+        {name: "internal", connected: true, ssid: "five-ghz", ip: "192.0.2.2", networks: [{ssid: "five-ghz"}]},
+        {name: "idle", connected: false, networks: []}
+    ]
+};
+test("selected adapter supplies status and networks rather than alphabetical first", () => {
+    const selected = wifi.selected(state, "internal");
+    assert.equal(selected.wifiSSID, "five-ghz");
+    assert.equal(selected.wifiIP, "192.0.2.2");
+    assert.equal(selected.wifiNetworks[0].ssid, "five-ghz");
+    assert.equal(selected.wifiDevicePath, "");
+    assert.equal(wifi.selected(state, "idle").wifiConnected, false);
+});
+test("Auto and an unplugged override fall back to backend selection", () => {
+    assert.equal(wifi.selected(state, ""), state);
+    assert.equal(wifi.selected(state, "unplugged"), state);
+});
+test("another adapter on the same SSID cannot complete a pending connection", () => {
+    assert.equal(wifi.completed(state, "two-ghz", "internal"), false);
+    assert.equal(wifi.completed(state, "two-ghz", "usb"), true);
+    assert.equal(wifi.completed({...state, wifiIP: ""}, "two-ghz", "usb"), false);
+});

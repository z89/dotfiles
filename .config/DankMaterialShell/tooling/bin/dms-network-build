#!/usr/bin/env bash
# Build an immutable DMS bundle; never restart services or change network profiles.
set -euo pipefail
tooling_bin=$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")
PATCH_DIR=${DMS_PATCH_DIR:-$tooling_bin/../../patches}
UI_BUILDER=${DMS_UI_BUILDER:-$tooling_bin/dms-shell-patch}
CACHE=${DMS_NETWORK_CACHE:-${XDG_CACHE_HOME:-$HOME/.cache}/dms-network}
STOCK=${DMS_STOCK_BINARY:-/usr/bin/dms}
STATE=${DMS_BUNDLE_STATE:-$tooling_bin/dms-bundle-state}
version=$(pacman -Q dms-shell-git | cut -d' ' -f2)
rev=$(printf '%s\n' "$version" | sed -nE 's/.*\.g([0-9a-f]+)-[0-9]+$/\1/p')
[[ -n "$rev" ]] || { echo "dms-network-build: cannot identify installed upstream commit: $version" >&2; exit 1; }
for file in "$STOCK" "$UI_BUILDER" "$STATE" "$tooling_bin/dms-matugen-thumb" "$PATCH_DIR/network-core.patch" "$PATCH_DIR/network-shell.patch"; do
    [[ -f "$file" ]] || { echo "dms-network-build: missing $file" >&2; exit 1; }
done
key=$({ sha256sum "$STOCK" "$UI_BUILDER" "$STATE" "$tooling_bin/dms-matugen-thumb" "$tooling_bin/dms-network-build"; find "$PATCH_DIR" -maxdepth 1 -type f -print0 | sort -z | xargs -0 sha256sum; printf 'THEME_SYNC=%s\n' "${THEME_SYNC:-1}"; } | sha256sum | cut -d' ' -f1)
mkdir -p "$CACHE"
exec 9>"$CACHE/.build.lock"
flock 9
bundle=$CACHE/$key
verify_theme_sync() {
    [[ ${THEME_SYNC:-1} == 1 ]] || return 0
    local shell=$1 marker
    [[ -x "$shell/scripts/dms-matugen-thumb" ]] || {
        echo "dms-network-build: theme sync thumbnail helper is missing" >&2
        return 1
    }
    for marker in paletteHeld consumerReady snapshotsPending palette-applied.stamp; do
        grep -rqF -- "$marker" "$shell/Common" "$shell/Modules" || {
            echo "dms-network-build: required theme sync marker is missing: $marker" >&2
            return 1
        }
    done
}
if [[ -f "$bundle/.ready" && -x "$bundle/dms" && -f "$bundle/shell/shell.qml" ]]; then
    verify_theme_sync "$bundle/shell"
    "$STATE" register "$bundle"
    exit 0
fi
[[ ! -e "$bundle" ]] || { echo "dms-network-build: incomplete bundle $bundle; inspect it before rebuilding" >&2; exit 1; }
tmp=$(mktemp -d "$CACHE/.build.XXXXXX")
trap 'rm -rf -- "$tmp"' EXIT
source_repo=${DMS_NETWORK_SOURCE:-$HOME/.cache/paru/clone/dms-shell-git/DankMaterialShell}
if git -C "$source_repo" cat-file -e "$rev^{commit}" 2>/dev/null; then
    git clone --no-hardlinks --no-checkout "$source_repo" "$tmp/source" >&2
    git -C "$tmp/source" remote set-url origin https://github.com/AvengeMedia/DankMaterialShell.git
else
    # Resolve the package's abbreviated commit before fetching, never build moving HEAD.
    full_rev=$(python3 - "$rev" <<'PY'
import json, sys, urllib.request
url = "https://api.github.com/repos/AvengeMedia/DankMaterialShell/commits/" + sys.argv[1]
request = urllib.request.Request(url, headers={"User-Agent": "dotfiles-dms-network-build"})
with urllib.request.urlopen(request, timeout=30) as response:
    rev = json.load(response)["sha"]
if len(rev) != 40 or not all(c in "0123456789abcdef" for c in rev) or not rev.startswith(sys.argv[1]):
    raise SystemExit("upstream commit does not match installed package")
print(rev)
PY
    )
    git init -q "$tmp/source"
    git -C "$tmp/source" remote add origin https://github.com/AvengeMedia/DankMaterialShell.git
    git -C "$tmp/source" fetch --depth 1 origin "$full_rev" >&2
fi
git -C "$tmp/source" checkout --detach "$rev" >&2
git -C "$tmp/source" submodule update --init --recursive >&2
if ! git -C "$tmp/source" apply --check "$PATCH_DIR/network-core.patch" ||
   ! git -C "$tmp/source" apply --check --directory=quickshell "$PATCH_DIR/network-shell.patch"; then
    echo "dms-network-build: network patches incompatible with $version; refusing an unpatched fallback" >&2
    exit 1
fi
git -C "$tmp/source" apply "$PATCH_DIR/network-core.patch"
git -C "$tmp/source" apply --directory=quickshell "$PATCH_DIR/network-shell.patch"
(
    cd "$tmp/source/core"
    go test -race ./internal/server/network
    make sync-shell
    CGO_ENABLED=0 go build -mod=readonly -trimpath -tags 'distro_binary withshell' \
        -ldflags "-s -w -X main.Version=$version-dotfiles-network -X main.commit=$rev" \
        -o "$tmp/dms" ./cmd/dms
) >&2
node --test "$tmp/source/quickshell/tests/multiwifi.test.mjs" >&2
# The visual patcher only writes into this new, unwatched staging directory.
DMS_NO_NOTIFY=1 DMS_SHELL_SRC="$tmp/source/core/internal/shellembed/dist" DMS_SHELL_PATCHED="$tmp/shell" \
    DMS_PATCH_DIR="$PATCH_DIR" "$UI_BUILDER" >&2
verify_theme_sync "$tmp/shell"
printf '%s\n' "$version" > "$tmp/.package-version"
printf '%s\n' "$key" > "$tmp/.ready"
# Keep source + tests for auditing and avoid changing any tree used by a running shell.
mv "$tmp" "$bundle"
trap - EXIT
"$STATE" register "$bundle"

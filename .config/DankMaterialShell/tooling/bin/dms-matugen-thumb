#!/usr/bin/env bash
# Run DMS matugen against a cached 640px wallpaper thumbnail.
# Usage: dms-matugen-thumb /absolute/dms matugen queue ... --value <image> ...
#        dms-matugen-thumb --warm <image>...
set -euo pipefail

cache=${XDG_CACHE_HOME:-$HOME/.cache}/dms-matugen-thumbs
thumb_for() {
    local src=$1 key thumb
    if [[ $src == "$cache"/* && -s $src ]]; then
        printf '%s' "$src"
        return
    fi
    key=$(printf '%s:%s' "$src" "$(stat -c %Y:%s -- "$src" 2>/dev/null)" | md5sum | cut -c1-16)
    thumb=$cache/$key.jpg
    if [[ ! -s $thumb ]]; then
        mkdir -p "$cache" || return
        if ! magick "$src[0]" -auto-orient -resize '640x640>' -quality 92 "$thumb.tmp.jpg" 2>/dev/null \
            || ! mv -f "$thumb.tmp.jpg" "$thumb"; then
            rm -f "$thumb.tmp.jpg"
            return
        fi
    fi
    printf '%s' "$thumb"
}

if [[ ${1:-} == --warm ]]; then
    shift
    for image in "$@"; do
        [[ -f $image ]] && thumb_for "$image" >/dev/null || true
    done
    exit 0
fi

backend=${1:-}
if [[ $backend != /* || ! -x $backend ]]; then
    echo "dms-matugen-thumb: selected DMS executable must be an absolute executable path" >&2
    exit 1
fi
shift
args=("$@")
for ((i = 0; i < ${#args[@]} - 1; i++)); do
    if [[ ${args[i]} == --value && ${args[i+1]} == /* && -f ${args[i+1]} ]]; then
        thumbnail=$(thumb_for "${args[i+1]}" || true)
        [[ -n $thumbnail ]] && args[i+1]=$thumbnail
        break
    fi
done
exec "$backend" "${args[@]}"

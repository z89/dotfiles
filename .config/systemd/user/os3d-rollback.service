[Unit]
Description=Restore the previous os3 binaries after a bad os3d deploy
Documentation=file:%h/.local/bin/os3d-rollback

# Nothing triggers this automatically any more: os3d.service used to carry
# OnFailure=os3d-rollback.service, and it does not, because a failed unit is
# not the same thing as a bad binary (see the comment in os3d.service). The
# automatic rollback that remains is scripts/deploy's own, which runs when the
# daemon it just restarted fails its health check or answers with the wrong
# build id — the one place where a new binary really is the new variable.
#
# This unit is the by-hand path, and it exists so that path needs no repo:
#
#     systemctl --user start os3d-rollback
#
# The rollback still cannot loop: os3d-rollback MOVES the .prev binaries back
# rather than copying them, so a second run finds nothing to restore, says so
# and stops. The start limit below is the belt to that braces.
StartLimitIntervalSec=600
StartLimitBurst=2

[Service]
Type=oneshot
# Deliberately the installed copy, not the repo checkout: a rollback has to
# work on a machine where the os3 checkout is missing, half-edited, or is
# exactly what broke the daemon. scripts/deploy installs this copy, along with
# os3d-health and the os3d-lib.sh both of them source.
ExecStart=%h/.local/bin/os3d-rollback
# Long enough for the -self-check on the .prev, the restart, and the health
# probe that decides whether the restored daemon is actually serving.
TimeoutStartSec=120

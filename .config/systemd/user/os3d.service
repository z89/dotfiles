[Unit]
Description=os3 daemon (Anya)
Documentation=file:%h/Documents/Github-Projects/os3/docs/POC_BOOTSTRAP.md
After=default.target

# The socket unit owns ~/.os3/os3d.sock and passes it in already listening.
# Requires, not Wants: a daemon that bound its own socket while os3d.socket
# was also listening on that path would be a second listener on a file only
# one process can serve, and the client would reach whichever won the race.
Requires=os3d.socket
After=os3d.socket

# If os3d cannot come up, systemd must stop hammering it: five starts in two
# minutes is a daemon that is not going to start.
StartLimitIntervalSec=120
StartLimitBurst=5

# There is deliberately no OnFailure=os3d-rollback.service here.
#
# OnFailure fires on any failed state, and the failure that actually happens is
# not the one it was written for. A daemon that starts cleanly, serves for an
# hour and then crash-loops on something in the home — a corrupt ledger, a
# thread.json it cannot parse — trips the start limit and lands in failed just
# the same. An automatic rollback there swaps in the previous binary against a
# home that is still broken, fails again, and has consumed the one .prev that
# existed. The rollback is a move, not a copy: there is exactly one of them.
#
# Rolling back is worth doing when a NEW binary is the new thing, and that is
# exactly the case scripts/deploy already covers: it health-checks the daemon
# it just restarted, compares the build id, and runs the rollback itself when
# that fails. So the automatic rollback lives where the evidence is, and here
# a failed unit stays failed and visible instead of quietly rewriting itself.
#
# By hand, when a bad binary is the diagnosis:  bash ~/.local/bin/os3d-rollback

[Service]
# Type=notify: the unit is not "started" until os3d sends READY=1, which it
# does once the listener is accepting. That is what makes a restart fail
# loudly on a build that cannot come up, instead of reporting success and
# leaving a dead unit behind for the health check to discover.
Type=notify
NotifyAccess=main
# A daemon that comes up sends READY=1 within a second; anything past this is
# not slow, it is stuck, and waiting the systemd default of 90s would leave
# `systemctl restart os3d` hanging for a minute and a half before the deploy
# could roll back. It also bounds a rollback to a binary older than
# Type=notify, which never sends READY=1 at all.
TimeoutStartSec=30
# Stopping is not instant and must not be cut short. os3d records its
# clean-shutdown marker and sends STOPPING=1 the moment the signal arrives,
# then drains: in-flight connections finish and a post-turn automatic
# compaction yields at its next phase boundary rather than mid-write, because
# a compaction killed between phases is what leaves a half-written checkpoint
# behind. A phase is a provider call, so the bound is a provider's latency and
# not a fixed cost of ours. The drain itself is bounded in code: the memory
# review drain (60s) plus the compaction yield plus one client write deadline
# (5s), so 90s covers the worst case with margin, and anything under 65s risks
# a SIGKILL that turns a working restart into a failed unit.
TimeoutStopSec=90
# WatchdogSec is not a liveness timer on the process — a wedged daemon is
# still a running process. os3d beats every 15s, and only after a probe has
# gone through the same mutex a status request takes, so a daemon whose locks
# are held for ever misses its beats and is restarted (cmd/os3d/sdnotify.go).
WatchdogSec=30
# The user manager's PATH is the one systemd built at login: it has neither
# ~/.local/bin nor an npm prefix on it, so `claude` and `codex` installed in
# either are simply not there for this unit while being perfectly findable
# from any shell. The two directories are PREPENDED rather than the whole PATH
# being replaced, because everything else on the manager's PATH — a cargo bin,
# a JVM, whatever the user has — is reachable by the tools the daemon runs,
# and an Environment=PATH= line would silently take all of it away.
# ${PATH} is expanded by systemd from the manager's environment; /usr/bin/env
# execs os3d in the same process, so the main pid, sd_notify and the watchdog
# are unaffected. scripts/deploy and scripts/rollback parse this very line and
# run their self-checks under the PATH it produces, so keep them in step.
#
# Refuse to start on a home the binary cannot read: -self-check validates the
# home read-only, opens no socket and exits within two seconds. A failing
# check fails the start. It is strict on purpose — there is no `-` prefix
# here, because an ignored ExecStartPre is not a gate. scripts/rollback runs
# the same check on a .prev before restoring it, so a rollback cannot install
# a binary that would fail this for ever.
ExecStartPre=/usr/bin/env PATH=%h/.local/bin:%h/.npm-global/bin:${PATH} %h/.local/bin/os3d -self-check
ExecStart=/usr/bin/env PATH=%h/.local/bin:%h/.npm-global/bin:${PATH} %h/.local/bin/os3d
Restart=always
RestartSec=2

# A stray ANTHROPIC_API_KEY silently bills the API instead of the Claude
# subscription: the headless `claude` call would authenticate with the key
# and the charge appears on the API account with no visible change in
# behaviour. Scrub it from the unit's environment.
UnsetEnvironment=ANTHROPIC_API_KEY

[Install]
# Still started eagerly at login rather than on the first connection: the
# daemon warms autosuggest and replays the ledger at start, and a user opening
# os3 should not wait for that. Activation covers the restart window, not the
# first start.
WantedBy=default.target

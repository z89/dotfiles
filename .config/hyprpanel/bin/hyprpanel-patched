#!/bin/bash
# Patched HyprPanel launcher.
# Decodes the JS bundle, then patches valign: CENTER on the bar's
# box-left/center/right containers so buttons don't stretch vertically
# when the bar has a custom min-height set in modules.scss.
# Also patches toggleWindow CLI command to position dropdown menus correctly.
# Also sets margin_left/margin_right on the bar window JSX element so the
# layer-shell surface is physically sized to the visible bar width, preventing
# the transparent CSS margin areas from capturing mouse input.
# The companion CSS override in modules.scss zeroes out the CSS margins so
# bar content fills the narrowed surface correctly.

JS="${XDG_RUNTIME_DIR:-/tmp}/dmFyIF-ags.js"
eval "$(sed '/gjs /d' /usr/share/hyprpanel/hyprpanel-app)"

# Patch bar window JSX to set layer-shell left/right margins from config.
# margin_left/margin_right on AstalWindow map directly to gtk_layer_shell_set_margin(),
# shrinking the surface so the areas beside the bar are free for other windows.
#
# Also patch _buildCssVariable to emit 0px for bar-margin_sides so the SCSS
# variable itself is zeroed out — bar.scss then generates margin-left: 0px
# naturally, preventing the CSS margin from collapsing inside the narrowed surface.
python3 -c "
with open('$JS', 'r') as f:
    content = f.read()

# Layer-shell margin patch
old1 = 'namespace: \`bar-\${this._hyprlandMonitor}\`,'
new1 = ('namespace: \`bar-\${this._hyprlandMonitor}\`,'
        ' margin_left: parseInt(String(configuration_default.theme.bar.margin_sides.get())) || 0,'
        ' margin_right: parseInt(String(configuration_default.theme.bar.margin_sides.get())) || 0,')
content = content.replace(old1, new1, 1)

# CSS variable patch — zero out bar-margin_sides in SCSS so the surface fills correctly
old2 = '  _buildCssVariable(variableName, property2) {\n    const propertyValue = property2.get();\n    return \`\$\${variableName}: \${propertyValue};\`;\n  }'
new2 = ('  _buildCssVariable(variableName, property2) {\n'
        '    if (variableName === \"bar-margin_sides\") return \`\$\${variableName}: 0px;\`;\n'
        '    const propertyValue = property2.get();\n'
        '    return \`\$\${variableName}: \${propertyValue};\`;\n'
        '  }')
content = content.replace(old2, new2, 1)

# _applyCss flash fix — animation frames should add CSS on top, not reset all providers.
# reset=true clears every CSS provider before re-applying, causing a blank-CSS flash each frame.
# Change applyColorOverrides to call _applyCss(false) so the new compiled CSS is layered in
# without wiping the existing providers mid-frame.
old3 = ('  _applyCss() {\n'
        '    const compiledCssPath = \`\${TMP}/main.css\`;\n'
        '    app_default.apply_css(compiledCssPath, true);\n'
        '  }')
new3 = ('  _applyCss(reset = true) {\n'
        '    const compiledCssPath = \`\${TMP}/main.css\`;\n'
        '    app_default.apply_css(compiledCssPath, reset);\n'
        '  }')
content = content.replace(old3, new3, 1)

# Change the applyColorOverrides call site to pass reset=false so animation frames
# don't clear existing CSS providers (eliminates per-frame flash during color-fade).
# The other call site (applyCss, used for full reloads) keeps reset=true by default.
old4 = ('      await this._compileSass(lines);\n'
        '      this._applyCss();\n'
        '    } catch (error) {')
new4 = ('      await this._compileSass(lines);\n'
        '      this._applyCss(false);\n'
        '    } catch (error) {')
content = content.replace(old4, new4, 1)

# Remove modules.scss from the HotReload monitor list.
# HyprPanel watches modules.scss for changes and calls applyCss(reset=true) when it fires.
# During theme switching, matugen writes modules.scss and the file monitor fires (with a
# ~200-500ms GFileMonitor delay) after color-fade has started accumulating CSS providers.
# The reset=true in that applyCss() wipes all animation providers, snapping colors back to
# the old theme mid-animation — causing the flash-back-to-old then re-animate sequence.
# Removing it from the monitor list prevents that race entirely. The new modules.scss content
# is still picked up on the first color-fade compilation frame since _compileSass reads it.
old5 = ('    \`\${CONFIG_DIR}/modules.scss\`\n'
        '  ];')
new5 = ('  ];')
content = content.replace(old5, new5, 1)

with open('$JS', 'w') as f:
    f.write(content)
"

# Apply valign patches
sed -i 's/className: "box-left", hexpand: true/className: "box-left", hexpand: true, valign: Gtk4.Align.CENTER/' "$JS"
sed -i 's/className: "box-center", halign: Gtk4.Align.CENTER/className: "box-center", halign: Gtk4.Align.CENTER, valign: Gtk4.Align.CENTER/' "$JS"
sed -i 's/className: "box-right", halign: Gtk4.Align.END/className: "box-right", halign: Gtk4.Align.END, valign: Gtk4.Align.CENTER/' "$JS"

# Vertically center the notification icon
sed -i 's/className: "notification-card-image-container"/className: "notification-card-image-container", valign: Gtk4.Align.CENTER/' "$JS"

# Patch toggleWindow handler to position dropdown menus before toggling.
# Uses a unique context match so we only patch the CLI toggleWindow handler.
python3 -c "
import re
with open('$JS', 'r') as f:
    content = f.read()

old = '''const windowStatus = foundWindow.visible ? \"hidden\" : \"visible\";
        app_default.toggle_window(windowName);'''

new = '''const windowStatus = foundWindow.visible ? \"hidden\" : \"visible\";
        if (isDropdownMenu(windowName) && windowStatus === \"visible\") {
          const deb = getDropdownEventBox(windowName);
          if (deb) {
            const mon = getFocusedHyprlandMonitor();
            if (mon) {
              const scale = mon.scale || 1;
              const mw = Math.floor(mon.width / scale);
              const barMarginSides = parseInt(String(configuration_default.theme.bar.margin_sides.get())) || 0;
              const outerSpacing = parseInt(String(configuration_default.theme.bar.outer_spacing.get())) || 0;
              const anchorX = barMarginSides + outerSpacing + 20;
              const dw = deb.get_child()?.get_allocation().width || 0;
              const { leftMargin, rightMargin } = calculateHorizontalMargins(mw, dw, anchorX);
              deb.set_margin_left(leftMargin);
              deb.set_margin_right(rightMargin);
            }
          }
        }
        app_default.toggle_window(windowName);'''

content = content.replace(old, new, 1)
with open('$JS', 'w') as f:
    f.write(content)
"

# Patch openDropdownMenu to offset click X by barMarginSides.
# event.get_root_coords() on Wayland returns surface-relative coords, not
# screen-absolute. With margin_left=barMarginSides on the bar layer-shell surface,
# all click X values are short by barMarginSides, causing dropdowns to appear
# barMarginSides pixels to the left of the correct position.
python3 -c "
with open('$JS', 'r') as f:
    content = f.read()

old = 'const adjustedXCoord = clickPos[1] + middleOffset;'
new = 'const adjustedXCoord = clickPos[1] + middleOffset + (parseInt(String(configuration_default.theme.bar.margin_sides.get())) || 0);'

content = content.replace(old, new, 1)
with open('$JS', 'w') as f:
    f.write(content)
"

# Add reloadCss command: re-reads /tmp/hyprpanel/main.css without SCSS recompilation.
# Used by color-fade to apply interpolated CSS at 60fps (applyTheme triggers a full
# sass compile at ~200ms/call which is too slow for smooth animation).
python3 -c "
with open('$JS', 'r') as f:
    content = f.read()

# Insert the reloadCss command after the applyTheme command block
old = '''        return \`Error applying theme: \${error}\`;
      }
    }
  },
  {
    name: \"setLayout\",'''

new = '''        return \`Error applying theme: \${error}\`;
      }
    }
  },
  {
    name: \"reloadCss\",
    aliases: [\"rc\"],
    description: \"Re-reads compiled CSS from /tmp/hyprpanel/main.css without SCSS recompilation.\",
    category: \"Appearance\",
    args: [],
    handler: () => {
      if (!globalThis.__cfProv) {
        globalThis.__cfProv = new Gtk4.CssProvider();
        Gtk4.StyleContext.add_provider_for_screen(
          Gdk.Screen.get_default(),
          globalThis.__cfProv,
          Gtk4.STYLE_PROVIDER_PRIORITY_USER
        );
      }
      globalThis.__cfProv.load_from_path(\`\${TMP}/main.css\`);
      return \"ok\";
    }
  },
  {
    name: \"clearFadeCss\",
    aliases: [\"cfc\"],
    description: \"Removes the color-fade CSS provider after animation completes.\",
    category: \"Appearance\",
    args: [],
    handler: () => {
      if (globalThis.__cfProv) {
        Gtk4.StyleContext.remove_provider_for_screen(
          Gdk.Screen.get_default(),
          globalThis.__cfProv
        );
        globalThis.__cfProv = null;
      }
      return \"ok\";
    }
  },
  {
    name: \"setLayout\",'''

content = content.replace(old, new, 1)
with open('$JS', 'w') as f:
    f.write(content)
"

# Redirect all internal restart/quit commands to the patched launcher.
# HyprPanel restarts itself via 'hyprpanel -q; hyprpanel' (stock launcher) in:
#   1. restartCommand option default (line ~4691)
#   2. useTheme function (line ~5389)
#   3. Hardcoded restart CLI handler (line ~15706)
#   4. Hardcoded quit CLI handler (line ~15721)
# The stock launcher re-decodes the JS bundle, overwriting all patches.
# Replace every occurrence with the patched launcher path.
PATCHED_LAUNCH="$HOME/.config/hyprpanel/bin/hyprpanel-launch"
sed -i \
    -e "s|\"hyprpanel -q; hyprpanel\"|\"$PATCHED_LAUNCH\"|g" \
    -e "s|'hyprpanel -q; hyprpanel'|'$PATCHED_LAUNCH'|g" \
    -e "s|'bash -c \"hyprpanel -q; hyprpanel\"'|'bash -c \"$PATCHED_LAUNCH\"'|g" \
    -e "s|'bash -c \"hyprpanel -q\"'|'bash -c \"pkill -f gjs.*dmFyIF-ags.js\"'|g" \
    "$JS"

exec gjs -m "$JS"

#!/bin/bash
# Reload-safe HyprPanel launcher.
# Kills any running instance before starting a fresh patched one.
# Called by hyprland.conf via 'exec =' so it runs on every reload.
pkill -f "gjs.*dmFyIF-ags.js" 2>/dev/null
sleep 0.3

# Persist the last theme colors into config.json before starting.
# color-fade applies colors via astal IPC (in-memory only), so config.json
# drifts stale after a theme switch. Merging the colors-new file here
# ensures hyprpanel always boots with the current theme.
# Check persistent path first (survives reboot), fall back to /tmp.
COLORS_PERSISTENT="$HOME/.config/hyprpanel/colors-new.json"
COLORS_TMP="/tmp/hyprpanel-colors-new.json"
if [[ -f "$COLORS_TMP" ]]; then
    COLORS_NEW="$COLORS_TMP"
elif [[ -f "$COLORS_PERSISTENT" ]]; then
    COLORS_NEW="$COLORS_PERSISTENT"
else
    COLORS_NEW=""
fi
CONFIG="$HOME/.config/hyprpanel/config.json"
if [[ -n "$COLORS_NEW" && -f "$CONFIG" ]]; then
    python3 -c "
import json
with open('$COLORS_NEW') as f:
    colors = json.load(f)
with open('$CONFIG') as f:
    config = json.load(f)
config.update(colors)
with open('$CONFIG', 'w') as f:
    json.dump(config, f, indent=2)
" 2>/dev/null
fi

~/.config/hyprpanel/bin/hyprpanel-patched &

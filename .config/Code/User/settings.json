{
  "terminal.integrated.fontFamily": "FiraCode Nerd Font",
  "terminal.integrated.fontSize": 12,
  "terminal.integrated.gpuAcceleration": "off",

  "editor.fontFamily": "'FiraCode Nerd Font', 'monospace'",
  "editor.fontLigatures": true,
  "editor.fontSize": 12,
  "editor.formatOnSave": true,
  "editor.cursorBlinking": "phase",
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.smoothScrolling": true,
  "workbench.list.smoothScrolling": false,
  "editor.inlineSuggest.enabled": true,

  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "prettier.printWidth": 150,
  "prettier.quoteProps": "preserve",
  "workbench.tree.indent": 10,

  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,

  "json.maxItemsComputed": 10000,

  "typescript.updateImportsOnFileMove.enabled": "always",
  "javascript.updateImportsOnFileMove.enabled": "always",

  "github.copilot.enable": {
    "*": true,
    "plaintext": true,
    "markdown": true,
    "scminput": false,
    "yaml": true,
    "cpp": true,
  },

  "git.confirmSync": false,
  "git.enableSmartCommit": true,
  "terminal.integrated.defaultProfile.linux": "zsh",
  "git.openRepositoryInParentFolders": "never",
  "security.workspace.trust.untrustedFiles": "open",
  "debug.onTaskErrors": "debugAnyway",
  "workbench.colorTheme": "Wal",

  "editor.linkedEditing": false,
  "VSCodeCounter.exclude": ["**/.gitignore", "**/.vscode/**", "**/node_modules/**", "package-lock.json", "**/old/**"],
  "files.associations": {
    "*.css": "tailwindcss",
  },
  "window.titleBarStyle": "custom",

  "window.customMenuBarAltFocus": false,
  "go.toolsManagement.autoUpdate": true,
  "[go]": {
    "editor.insertSpaces": true,
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "golang.go",
  },
  "editor.defaultColorDecorators": "auto",
  "vscode-color-picker.languages": ["html", "css", "javascript", "javascriptreact", "typescript", "typescriptreact"],
  "sonarlint.rules": {
    "typescript:S6848": {
      "level": "off",
    },
  },
  "extensions.ignoreRecommendations": true,
  "terraform.languageServer.enable": true,
  "[terraform]": {
    "editor.defaultFormatter": "hashicorp.terraform",
  },
  "github.copilot.nextEditSuggestions.enabled": true,
  "[cpp]": {
    "editor.defaultFormatter": "ms-vscode.cpptools",
  },
  "java.format.settings.url": "https://raw.githubusercontent.com/google/styleguide/gh-pages/eclipse-java-google-style.xml",
  "java.format.settings.profile": "GoogleStyle",
  "explorer.confirmPasteNative": false,
  "python.createEnvironment.trigger": "off",
  "codemap.useNoDependencyCSharpMapper": true,
  "yaml.schemas": {
    "file:///home/archie/.vscode/extensions/continue.continue-1.2.10-linux-x64/config-yaml-schema.json": [".continue/**/*.yaml"],
  },
  "[java]": {
    "editor.defaultFormatter": "redhat.java",
  },
  "jdk.telemetry.enabled": false,
  "terminal.integrated.suggest.enabled": false,
  "claudeCode.preferredLocation": "panel",
  "terminal.integrated.initialHint": false,
  "comments.openView": "never",
  "claudeCode.selectedModel": "default",
  "[dart]": {
    "editor.formatOnSave": true,
    "editor.formatOnType": true,
    "editor.rulers": [80],
    "editor.selectionHighlight": false,
    "editor.tabCompletion": "onlySnippets",
    "editor.wordBasedSuggestions": "off",
  },
  "dart.openDevTools": "flutter",
}

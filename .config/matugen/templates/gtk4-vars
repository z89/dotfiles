/* Auto-generated by matugen (user template). Accent and status colours only: palette-gen owns the surface colours (window, view, sidebar, headerbar, cards), which libadwaita maps from the @define-color names. */
:root {
  --accent-bg-color: {{colors.primary.default.hex}};
  --accent-fg-color: {{colors.on_primary.default.hex}};
  --accent-color: {{colors.primary.default.hex}};
  --destructive-bg-color: {{colors.error.default.hex}};
  --destructive-fg-color: {{colors.on_error.default.hex}};
  --destructive-color: {{colors.error.default.hex}};
  --success-bg-color: {{colors.tertiary.default.hex}};
  --success-fg-color: {{colors.on_tertiary.default.hex}};
  --warning-bg-color: {{colors.secondary.default.hex}};
  --warning-fg-color: {{colors.on_secondary.default.hex}};
  --error-bg-color: {{colors.error.default.hex}};
  --error-fg-color: {{colors.on_error.default.hex}};
  /* Material roles for palette-gen, which copies them into kitty's 256-colour slots (fastfetch). */
  --md-primary: {{colors.primary.default.hex}};
  --md-primary_container: {{colors.primary_container.default.hex}};
  --md-primary_fixed: {{colors.primary_fixed.default.hex}};
  --md-primary_fixed_dim: {{colors.primary_fixed_dim.default.hex}};
  --md-inverse_primary: {{colors.inverse_primary.default.hex}};
  --md-secondary: {{colors.secondary.default.hex}};
  --md-secondary_container: {{colors.secondary_container.default.hex}};
  --md-secondary_fixed: {{colors.secondary_fixed.default.hex}};
  --md-secondary_fixed_dim: {{colors.secondary_fixed_dim.default.hex}};
  --md-tertiary: {{colors.tertiary.default.hex}};
  --md-tertiary_container: {{colors.tertiary_container.default.hex}};
  --md-tertiary_fixed: {{colors.tertiary_fixed.default.hex}};
  --md-tertiary_fixed_dim: {{colors.tertiary_fixed_dim.default.hex}};
  --md-error: {{colors.error.default.hex}};
  --md-error_container: {{colors.error_container.default.hex}};
  --md-source_color: {{colors.source_color.default.hex}};
  --md-surface: {{colors.surface.default.hex}};
  --md-surface_container_lowest: {{colors.surface_container_lowest.default.hex}};

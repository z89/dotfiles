# Auto-generated by matugen — satty annotation tool, Material You palette
[general]
early-exit = true
initial-tool = "brush"
copy-command = "wl-copy"
output-filename = "~/Pictures/Screenshots/%Y-%m-%d_%H-%M-%S.png"
save-after-copy = true
corner-roundness = 12
annotation-size-factor = 1.5
actions-on-enter = ["save-to-clipboard"]
actions-on-escape = ["exit"]

[font]
family = "Inter"
style = "Medium"

[color-palette]
palette = [
    "{{colors.primary.default.hex}}",
    "{{colors.tertiary.default.hex}}",
    "{{colors.error.default.hex}}",
    "{{colors.secondary.default.hex}}",
    "{{colors.on_surface.default.hex}}",
    "{{colors.surface.default.hex}}",
]
